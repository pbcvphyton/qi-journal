{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set nq = s.quotes|length %}
{#- As linhas dividem a altura que realmente sobra no quadro (flex), com teto de 150 px: com 6 cotações
    ficam ≈ 140 px. Com 8 ou mais, valor e rótulo encolhem para caber (mín. ≈ 100 px por linha). -#}
{% set dense = nq >= 8 %}
{% set v_fs = 46 if dense else (52 if nq >= 7 else 58) %}
{% set l_fs = 34 if dense else 40 %}
{% block theme %}t-dark{% endblock %}
{% block style %}
.title{margin-top:40px;flex:none}
.title h1{font-size:80px;line-height:1.02}
.title .d i.sq{display:block;width:18px;height:18px;background:var(--orange)}
.title .d{display:flex;align-items:center;gap:16px;margin-top:20px;font-family:var(--mono);font-weight:600;font-size:32px;letter-spacing:.06em;color:var(--ink);text-transform:uppercase}
.list{margin-top:32px;border-top:2px solid var(--rule2);flex:1 1 auto;min-height:0;display:flex;flex-direction:column}
.q{flex:1 1 0;max-height:150px;min-height:0;border-bottom:2px solid var(--rule);display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;align-content:center;column-gap:24px;row-gap:8px;overflow:hidden}
.q .l{font-family:var(--sans);font-weight:700;font-size:{{ l_fs }}px;line-height:1.05}
.q .l small{font-family:var(--mono);font-weight:500;font-size:26px;color:var(--ink3);margin-left:14px;letter-spacing:.03em}
.q .v{grid-column:1;font-family:var(--mono);font-weight:600;font-size:{{ v_fs }}px;line-height:1;letter-spacing:-.02em}
.q .c{grid-column:2;grid-row:1 / span 2;align-self:center;text-align:right}
.q .c .fl{font-family:var(--mono);font-size:28px;color:var(--ink3);letter-spacing:.04em}
.src{margin-top:22px;font-family:var(--mono);font-size:26px;color:var(--ink3);flex:none}
{% endblock %}
{% block body %}
<div class="frame">
  <div class="hdr">{{ m.logo(240) }}<span class="lbl">Edição da manhã</span></div>
  {# o story sai às 07:10, antes de o dólar (9h) e a B3 (10h) abrirem: "antes da abertura", não "na abertura" #}
  <div class="title"><h1 class="sec-title">Mercado antes da abertura</h1><div class="d"><i class="sq"></i>{{ s.date }} · cotações da manhã</div></div>
  <div class="list">
    {% for q in s.quotes %}
    <div class="q{{ ' rate' if not q.change else '' }}">
      <div class="l">{{ q.label }}{% if q.ref %}<small>{{ q.ref }}</small>{% endif %}</div>
      <div class="c">{% if q.change %}{{ m.change(q, 44) }}{% else %}<span class="fl">taxa vigente</span>{% endif %}</div>
      <div class="v">{{ q.value }}</div>
    </div>
    {% endfor %}
  </div>
  <p class="src">Dados: Yahoo Finance, Banco Central</p>
</div>
{% endblock %}
