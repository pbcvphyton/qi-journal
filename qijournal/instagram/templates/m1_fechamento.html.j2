{# Em 1 minuto 2.0 · fechamento (§5.4): marinho. Uma estatística do dia, a pauta solitária: o número em laranja
   ("1.039"), a frase com a base ("de 1.159 assuntos de hoje (90%) saíram em uma fonte só."), a matriz de pontos
   (graficos.matriz_pontos, svg pronto) e o único CTA. O laranja fica no número e nos pontos de 1 fonte. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block theme %}t-dark v2{% endblock %}
{% block style %}
.kicker{flex:none;margin-top:30px;font-family:var(--mono);font-weight:600;font-size:24px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.numbox{flex:none;margin-top:18px}
.frase{flex:none;margin-top:18px;font-family:var(--serif);font-weight:600;font-size:46px;line-height:1.18;letter-spacing:-.01em;color:var(--ink);
  text-wrap:balance;overflow:hidden;max-height:3.6em}
.grafico{flex:none;margin-top:40px}
/* a pauta solitária é o dado do slide: os pontos de 1 fonte (e o da legenda) saem do cinza apagado para o laranja */
.graf-matriz circle[fill-opacity='0.26']{fill:var(--g-hi);fill-opacity:.9}
.cta{flex:none;margin-top:auto;padding-top:24px;border-top:4px solid var(--ink)}
.cta .hook{font-size:84px;max-height:2.1em}
{% endblock %}
{% block body %}
{{ m.serie_band(s.selo, true, 'em1min') }}
<div class="frame">
  <div class="kicker">{{ s.kicker }}</div>
  {{ m.num_hero(s.valor, none, s.tam, 140, true) }}
  <p class="frase" data-fit="fechamento-frase" data-min="34">{{ m.tx(s.frase) }}</p>
  {{ m.grafico(s.grafico) }}
  <div class="cta"><h2 class="hook" data-fit="cta" data-min="60">{{ s.cta }}</h2></div>
</div>
{{ m.assinatura(s.nota) }}
{% endblock %}
