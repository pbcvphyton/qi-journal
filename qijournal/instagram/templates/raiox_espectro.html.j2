{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "_raiox.html.j2" as rx with context %}
{% set c = s.counts %}
{% set total = c.total if c.total else ((s.a|length) + (s.n|length) + (s.b|length)) %}
{# blocos preenchidos na cor do lado: o nome do veículo carrega o lado, sem depender da coluna.
   Regra única do neutro em todo o Raio-X (capa, localizador e aqui): só aparece quando há neutro.
   Sem neutro, o espectro tem duas colunas, A e B. #}
{% set has_n = (s.n|length) > 0 %}
{% set cols = [('a', 'Lado A', '#394A7A', s.a)] + ([('n', 'Neutro', '#4B5563', s.n)] if has_n else []) + [('b', 'Lado B', '#0F7C8C', s.b)] %}
{% set ncol = cols|length %}
{% set most = [s.a|length, s.n|length, s.b|length, 1]|max %}
{# formato único da contagem: "2 de 4" sempre; o percentual entra menor, ao lado do nome do lado,
   só com amostra que o sustente (≥ 8 veículos) #}
{% set show_pct = total >= 8 %}
{# a manchete do assunto (o gerador manda s.headline em todos os slides do Raio-X) #}
{% set subject = s.get('headline') %}
{% set long_subj = subject and (subject|length) > 100 %}
{# poucos veículos: linhas e cartões maiores (sem buraco no meio); muitos: tudo mais compacto #}
{% set roomy = most <= 2 %}
{% set crowded = most >= 4 or (most >= 3 and long_subj) %}
{# legenda: 34 px com poucos veículos, 30/28 px com muitos; altura calculada pelo tamanho dos textos (≈ 1800/fs caracteres por linha) #}
{% set ks = namespace(fs=28, lines=0) %}
{% for f in ([34, 30, 28] if roomy else [30, 28]) %}
  {% set ln = ((s.side_a|length) / (1800 / f))|round(0, 'ceil') + ((s.side_b|length) / (1800 / f))|round(0, 'ceil') %}
  {% if ks.lines == 0 and (ln <= (4 if roomy else 5) or f == 28) %}{% set ks.fs = f %}{% set ks.lines = ln %}{% endif %}
{% endfor %}
{% set key_fs = ks.fs %}
{% set key_h = (ks.lines * key_fs * 1.26 + 4 * 0.42 * key_fs + 2 * key_fs * 0.24 + 10)|round(0, 'ceil')|int %}
{% set list_fs = 36 if roomy else (33 if most <= 3 else 30) %}
{% block theme %}t-dark{% endblock %}
{% block style %}
{{ rx.css() }}
.title{display:flex;align-items:flex-end;justify-content:space-between;margin-top:{{ 28 if crowded else 36 }}px;flex:none}
.title .sec-title{font-size:{{ 72 if crowded else 80 }}px}
.title span{font-family:var(--mono);font-weight:600;font-size:30px;letter-spacing:.04em;color:var(--ink2);padding-bottom:8px}
.sub{margin-top:10px;font-family:var(--sans);font-weight:600;font-size:36px;line-height:1.2;color:var(--ink2);flex:none}
.subj{margin-top:{{ 18 if crowded else 22 }}px;font-family:var(--serif);font-weight:600;font-size:{{ (32 if crowded else 34) if long_subj else 38 }}px;line-height:1.22;color:var(--ink);
  max-height:{{ 136 if long_subj else 106 }}px;overflow:hidden;--clamp:{{ 3 if long_subj else 2 }};flex:none;padding-left:22px;border-left:6px solid var(--orange)}
/* legenda logo abaixo do título: o que A e B significam, antes das contagens */
.key{margin-top:{{ 30 if roomy else (20 if crowded else 24) }}px;flex:none;display:flex;flex-direction:column;font-size:{{ key_fs }}px;max-height:{{ key_h }}px;overflow:hidden}
.key .r{display:grid;grid-template-columns:150px 1fr;column-gap:18px;align-items:baseline;border-top:2px solid var(--rule);padding:.42em 0}
.key .r:last-child{border-bottom:2px solid var(--rule)}
.key .r b{display:flex;align-items:center;gap:12px;font-family:var(--mono);font-weight:600;font-size:28px;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.key .r b i{display:block;width:22px;height:22px;flex:none}
.key .r p{font-family:var(--sans);font-weight:500;font-size:1em;line-height:1.26;color:var(--ink)}
/* as três colunas são UMA grade: cabeçalhos na linha 1 e o n-ésimo veículo de cada lado na mesma linha,
   então um nome que quebra em 2 linhas ("Folha de S.Paulo") alarga a linha inteira e a grade fica alinhada.
   O data-fit fica no contêiner e os nomes usam em: as três colunas têm sempre o mesmo corpo. */
.cols{display:grid;grid-template-columns:repeat({{ ncol }},minmax(0,1fr));column-gap:18px;row-gap:8px;align-content:start;
  margin-top:{{ 34 if roomy else (22 if crowded else 28) }}px;flex:0 1 auto;min-height:0;overflow:hidden;font-size:{{ list_fs }}px}
.cols .h{padding:{{ '14px 20px 16px' if crowded else '18px 20px 20px' }};color:#fff;box-shadow:inset 0 0 0 2px rgba(255,255,255,.16);margin-bottom:4px}
.cols .h .k{display:flex;align-items:baseline;justify-content:space-between;gap:10px;font-family:var(--mono);font-weight:600;font-size:28px;letter-spacing:.06em;text-transform:uppercase}
.cols .h .k small{font-size:26px;font-weight:500;letter-spacing:.02em;color:rgba(255,255,255,.86)}
.cols .h .num{display:flex;align-items:baseline;gap:16px;margin-top:8px}
.cols .h .num b{font-size:{{ 136 if roomy else (88 if crowded else 112) }}px;line-height:.86}
.cols .h .num span{font-family:var(--mono);font-weight:600;font-size:30px;color:#fff;white-space:nowrap}
.cols .h .meter{height:10px;background:rgba(255,255,255,.26);margin-top:{{ 12 if crowded else 16 }}px}
.cols .h .meter i{display:block;height:100%;background:#fff}
.cols .li{display:flex;align-items:center;padding:{{ '.62em .55em .66em' if roomy else '.4em .5em .44em' }};font-family:var(--mono);font-weight:600;font-size:1em;line-height:1.15;color:#fff;letter-spacing:-.01em;min-width:0}
.cols .li.none{justify-content:center;color:var(--ink3);background:transparent!important;box-shadow:inset 0 0 0 2px rgba(246,244,239,.22);font-weight:500}
.ftr{margin-top:auto;padding-top:18px}
/* se nem no mínimo couber, corta embaixo sem desmontar a grade */
.cols.fit-clamp{display:grid!important}
.key.fit-clamp{display:flex!important}
{% endblock %}
{% block body %}
{{ m.rx_band() }}
<div class="frame">
  {{ m.header('Raio-X da cobertura') }}
  <div class="title"><h1 class="sec-title">O espectro</h1><span>{{ total }} veículos</span></div>
  <p class="sub">Quem foi para cada lado</p>
  {% if subject %}<p class="subj" data-fit="espectro-assunto" data-min="30">{{ m.tx(subject) }}</p>{% endif %}
  <div class="key" data-fit="espectro-legenda" data-min="26">
    <div class="r"><b><i style="background:#394A7A;box-shadow:0 0 0 2px #8C9BD0"></i>Lado A</b><p>{{ m.tx(s.side_a) }}</p></div>
    <div class="r"><b><i style="background:#0F7C8C;box-shadow:0 0 0 2px #5FC3D1"></i>Lado B</b><p>{{ m.tx(s.side_b) }}</p></div>
  </div>
  <div class="cols" data-fit="espectro-colunas" data-min="26">
    {% for key, name, color, names in cols %}
    {% set cnt = names|length %}
    {% set pct = (cnt * 100 / total)|round|int if total else 0 %}
    <div class="h" style="grid-column:{{ loop.index }};grid-row:1;background:{{ color }}">
      <div class="k">{{ name }}{% if show_pct %}<small>{{ pct }}%</small>{% endif %}</div>
      <div class="num"><b class="numd">{{ cnt }}</b><span>de {{ total }}</span></div>
      <div class="meter"><i style="width:{{ pct }}%"></i></div>
    </div>
    {% endfor %}
    {% for i in range(most) %}
    {% for key, name, color, names in cols %}
    {% if i < names|length %}<div class="li" style="grid-column:{{ loop.index }};grid-row:{{ i + 2 }};background:{{ color }}">{{ names[i] }}</div>
    {% elif i == 0 %}<div class="li none" style="grid-column:{{ loop.index }};grid-row:2">nenhum</div>{% endif %}
    {% endfor %}
    {% endfor %}
  </div>
  {{ rx.footer_rx() }}
</div>
{% endblock %}
