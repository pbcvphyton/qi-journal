{# Manifesto · slide 2, o funil (§4.7): os números da edição do D0, com a data, em 4 degraus que estreitam
   (notícias → assuntos → coberturas comparadas → matérias). As faixas são esquemáticas, fora de escala: o
   tamanho do número e a largura do degrau marcam a ordem, a conta está escrita em cada um. Papel. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block theme %}t-paper v2{% endblock %}
{% block style %}
.kicker{flex:none;margin-top:30px;font-family:var(--mono);font-weight:600;font-size:24px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.hook{flex:0 1 auto;min-height:0;margin-top:14px;line-height:.96}
.fun{flex:none;margin-top:40px;display:flex;flex-direction:column;gap:14px}
.st{display:flex;align-items:center;gap:28px;min-height:146px;padding:18px 28px;background:var(--ink);color:var(--bg)}
.st:nth-child(1){width:100%} .st:nth-child(2){width:92%} .st:nth-child(3){width:84%} .st:nth-child(4){width:76%}
.st .n{flex:none;width:{{ s.col_num }}px;font-family:var(--hook);font-stretch:62%;font-weight:900;font-size:120px;line-height:.9;letter-spacing:-.01em;
  font-variant-numeric:tabular-nums lining-nums;white-space:nowrap}
.st .x{min-width:0}
.st .r{display:block;font-family:var(--label);font-stretch:100%;font-weight:700;font-size:40px;line-height:1.08}
.st .d{display:block;margin-top:6px;font-family:var(--serif);font-size:26px;line-height:1.3;opacity:.86}
/* o degrau do destaque em laranja chapado com marinho (5,7:1), como a capa */
.st.hi{background:var(--orange);color:#0F1730}
.st.hi .d{opacity:1}
.pe{flex:none;margin-top:auto;padding-top:18px;margin-bottom:0;border-top:2px solid var(--rule);font-family:var(--mono);font-size:21px;line-height:1.4;color:var(--ink2)}
{% endblock %}
{% block body %}
{{ m.serie_band(s.selo, true, 'numero') }}
<div class="frame">
  <div class="kicker">{{ s.kicker }}</div>
  {{ m.hook(s.titulo, s.destaque, s.tam, 72) }}
  <div class="fun">
    {% for x in s.etapas %}<div class="st{{ ' hi' if loop.last }}"><span class="n">{{ x.n }}</span><span class="x"><span class="r">{{ x.rotulo }}</span><span class="d">{{ x.desc }}</span></span></div>{% endfor %}
  </div>
  <div class="pe" data-fit="base" data-min="16">{{ s.pe }}</div>
</div>
{{ m.assinatura(s.nota) }}
{% endblock %}
