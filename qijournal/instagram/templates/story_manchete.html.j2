{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set hl = s.headline|length %}
{# manchete: 104 px até 45 caracteres, 96 até 60, 88 até 110, 80 até 140, 76 acima (manchete curta ganha corpo);
   estimativa de linhas ≈ 0,52 em por caractere em 936 px #}
{% set h_fs = 104 if hl <= 45 else (96 if hl <= 60 else (88 if hl <= 110 else (80 if hl <= 140 else 76))) %}
{% set h_lines = (hl / (936 / (h_fs * 0.52)))|round(0, 'ceil')|int %}
{# com manchete de mais de 5 linhas, o "por que importa" fica em até 5 linhas (senão, 7) #}
{% set why_lines = 5 if h_lines > 5 else 7 %}
{% block theme %}t-dark{% endblock %}
{% block style %}
/* etiqueta + manchete + "por que importa" formam um bloco só, centrado na altura livre entre o cabeçalho
   e as fontes (sem vão no meio). O bloco não encolhe: se faltar altura, o quadro transborda e o guarda reduz a letra */
.main{flex:1 0 auto;display:flex;flex-direction:column;justify-content:center;padding:40px 0 40px}
.meta{display:flex;align-items:center;gap:18px;flex-wrap:wrap;flex:none}
h1{margin-top:36px;font-family:var(--serif);font-weight:800;font-size:{{ h_fs }}px;line-height:1.05;letter-spacing:-.014em;color:#F6F4EF;
  max-height:{{ (h_fs * 1.05 * 7 + 20)|round|int }}px;overflow:hidden;--clamp:7;flex:none}
.why{margin-top:60px;border-top:2px solid var(--rule2);padding-top:28px;flex:none}
.why .k{display:flex;align-items:center;gap:14px;color:var(--orange)}
.why p{margin-top:18px;font-family:var(--sans);font-weight:500;font-size:42px;line-height:1.32;color:var(--ink);max-height:{{ (42 * 1.32 * why_lines + 12)|round|int }}px;overflow:hidden;--clamp:{{ why_lines }}}
.src .more{color:var(--ink3)}
.srcbox{flex:none;display:flex;flex-direction:column;gap:8px;border-top:2px solid var(--rule);padding-top:22px}
.src{font-family:var(--mono);font-size:28px;line-height:1.35;color:var(--ink2);max-height:84px;overflow:hidden;--clamp:2}
.src b{color:var(--ink);font-weight:600;margin-right:8px}
.ai{font-family:var(--sans);font-weight:500;font-size:26px;line-height:1.3;color:var(--ink3)}
{% endblock %}
{% block body %}
<div class="frame">
  <div class="hdr">{{ m.logo(240) }}<span class="lbl">Manchete do dia</span></div>
  <div class="main">
    <div class="meta"><span class="tag orange">Manchete</span>{% if s.get('section') %}{{ m.section_chip(s.section) }}{% endif %}</div>
    <h1 data-fit="story-manchete" data-min="64">{{ m.tx(s.headline) }}</h1>
    {% if s.get('why') %}
    <div class="why">
      <span class="lbl strong k">{{ m.tri(26) }}<span style="color:var(--orange)">Por que importa</span></span>
      <p data-fit="story-porque" data-min="34">{{ m.tx(s.why) }}</p>
    </div>
    {% endif %}
  </div>
  <div class="srcbox">
    {% if s.get('sources') %}<p class="src" data-fit="story-fontes" data-min="26"><b>Fontes</b>{{ m.sources(s.sources) }}</p>{% endif %}
    <p class="ai">Resumo automático por IA a partir das fontes citadas</p>
  </div>
</div>
{% endblock %}
