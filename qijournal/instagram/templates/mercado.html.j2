{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set moving = s.quotes|selectattr('change')|list %}
{% set rates = s.quotes|rejectattr('change')|list %}
{% set wx = s.weather[0] if s.get('weather') else None %}
{% block theme %}t-dark{% endblock %}
{% block style %}
.title{display:flex;align-items:flex-end;justify-content:space-between;margin-top:40px;flex:none}
.title .d{font-family:var(--mono);font-weight:600;font-size:32px;color:var(--ink2);letter-spacing:.04em;padding-bottom:8px}
.wx{display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:26px;color:var(--ink2);letter-spacing:.04em;line-height:1}
.wx svg{color:var(--ink2)}
table{width:100%;border-collapse:collapse;margin-top:26px}
th{font-family:var(--mono);font-weight:500;font-size:26px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink3);text-align:left;padding:0 0 12px;border-bottom:2px solid var(--rule2)}
th.r,td.r{text-align:right}
td{border-bottom:2px solid var(--rule);height:{{ 92 if moving|length <= 7 else (640 // moving|length) }}px;vertical-align:middle}
/* linha com referência ("fech. 19/10"): mais alta, com o mesmo respiro em cima e embaixo das demais */
tr.ref td{height:{{ 112 if moving|length <= 7 else (640 // moving|length + 16) }}px;padding:14px 0 16px}
td.l{font-family:var(--sans);font-weight:700;font-size:38px;line-height:1.05}
td.l small{display:block;font-family:var(--mono);font-weight:500;font-size:26px;color:var(--ink3);letter-spacing:.03em;margin-top:8px;line-height:1.1}
td.v{font-family:var(--mono);font-weight:600;font-size:42px;letter-spacing:-.01em}
td.c{width:250px}
.rates{display:flex;gap:18px;margin-top:28px;flex:none}
.rate{flex:1 1 0;border:2px solid var(--rule2);padding:18px 24px;display:flex;align-items:baseline;justify-content:space-between;gap:12px;background:var(--panel)}
.rate .k{font-family:var(--sans);font-weight:700;font-size:32px}
.rate .k small{display:block;font-family:var(--mono);font-weight:500;font-size:26px;color:var(--ink3);margin-top:4px}
.rate .v{font-family:var(--mono);font-weight:600;font-size:52px;color:var(--ink)}
{% endblock %}
{% block body %}
<div class="frame">
  <div class="hdr">{{ m.logo(196) }}
    {% if wx %}<span class="wx">{{ m.weather_icon(wx.current_desc, 40) }}{{ wx.city }} {{ m.t0(wx.current_c) }} °C</span>{% else %}<span class="lbl">Em 1 minuto</span>{% endif %}
  </div>
  <div class="title"><h1 class="sec-title">{{ s.title }}</h1>{% if s.get('date') %}<span class="d">{{ s.date }}</span>{% endif %}</div>
  {% if moving %}
  <table>
    <tr><th>Ativo</th><th class="r">Cotação</th><th class="r">Variação</th></tr>
    {% for q in moving %}
    <tr{% if q.ref %} class="ref"{% endif %}><td class="l">{{ q.label }}{% if q.ref %}<small>{{ q.ref }}</small>{% endif %}</td>
      <td class="v r">{{ q.value }}</td>
      <td class="c r">{{ m.change(q, 38) }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% if rates %}
  <div class="rates">
    {% for q in rates %}
    <div class="rate"><span class="k">{{ q.label }}{% if q.ref %}<small>{{ q.ref }}</small>{% endif %}</span><span class="v">{{ q.value }}</span></div>
    {% endfor %}
  </div>
  {% endif %}
  {# a referência ("fech. 19/10") fica só na linha do ativo, sem nota repetida embaixo;
     cotação não é resumo de IA: o rodapé diz de onde vêm os números #}
  {{ m.footer('Dados: Yahoo Finance, Banco Central') }}
</div>
{% endblock %}
