{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set parts = s.kicker.split(' · ', 1) %}
{#- No "Comece aqui" (perene, fica fixado) o gerador já manda o número arredondado ("mais de 1.500"). -#}
{% set headline = s.headline %}
{% set hl = headline|length %}
{# no "Comece aqui" a manchete são duas frases curtas: cada uma começa numa linha, em 88 px #}
{% set sentences = headline.split('. ') if slot == 'lancamento' else [headline] %}
{# manchete longa (> 110 caracteres): a linha fina sai e a manchete fica com o espaço #}
{% set show_dek = s.get('dek') and hl <= 110 %}
{% set h1_size = 88 if slot == 'lancamento' else (112 if hl <= 45 else (96 if hl <= 80 else 88)) %}
{% set tparts = s.teaser.split(' · ') %}
{% block theme %}t-dark{% endblock %}
{% block style %}
.top{display:flex;align-items:flex-start;justify-content:space-between;flex:none;padding-bottom:22px}
.tagline{margin-top:18px;font-family:var(--mono);font-size:26px;letter-spacing:.06em;color:var(--ink3);text-transform:uppercase}
.top .datebox{margin-top:4px}
/* etiqueta + manchete + linha fina ocupam o miolo, centradas entre a régua e a chamada */
.lead{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:32px;padding:44px 0 48px}
.row{display:flex;align-items:center;gap:18px;flex-wrap:wrap;flex:none}
h1{font-family:var(--serif);font-weight:800;font-size:{{ h1_size }}px;line-height:1.05;letter-spacing:-.014em;color:#F6F4EF;
  max-height:{{ 600 if show_dek else 760 }}px;overflow:hidden;--clamp:{{ 6 if show_dek else 8 }};flex:none}
.dek{font-family:var(--sans);font-weight:500;font-size:36px;line-height:1.34;color:var(--ink2);max-height:212px;overflow:hidden;--clamp:4;flex:none}
.cta-bar .go{color:var(--orange)}
h1 .sn{display:block}
{% endblock %}
{% block body %}
<div class="frame">
  <div class="top">
    <div>{{ m.logo(330) }}<div class="tagline">{{ brand.tagline }}</div></div>
    {% if parts|length > 1 %}{{ m.datebox(parts[1]) }}{% endif %}
  </div>
  <div class="rule2x"></div>
  <div class="lead">
    <div class="row">
      <span class="tag orange">{{ parts[0] }}</span>
      {% if s.get('section') and (s.section.color|lower) != '#ff5a1f' %}{{ m.section_chip(s.section) }}{% endif %}
    </div>
    <h1 data-fit="capa-manchete" data-min="64">{% for t in sentences %}<span class="sn">{{ m.tx(t ~ ('.' if not loop.last else '')) }}</span>{% endfor %}</h1>
    {% if show_dek %}<p class="dek" data-fit="capa-linha-fina" data-min="32">{{ m.tx(s.dek) }}</p>{% endif %}
  </div>
  <div class="cta-bar">
    <span>{{ tparts[0] }}</span>
    <span class="go">{{ tparts[1] if tparts|length > 1 else 'arraste' }}{{ m.go_arrow() }}</span>
  </div>
</div>
{% endblock %}
