{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "_raiox.html.j2" as rx with context %}
{% set dl = (s.dek or '')|length %}
{% set dek_fs = 64 if dl <= 180 else (58 if dl <= 260 else 52) %}
{% block theme %}t-paper{% endblock %}
{% block style %}
{{ rx.css() }}
.k{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:56px;flex:none}
.hl{margin-top:34px;font-family:var(--sans);font-weight:700;font-size:34px;line-height:1.28;color:var(--ink2);max-height:140px;overflow:hidden;--clamp:3;flex:none;
  padding-left:22px;border-left:6px solid var(--orange)}
/* a linha fina ocupa o espaço que sobra (flex) e o ajuste reduz a letra se faltar; linha fina curta ganha corpo maior */
.dek{margin-top:40px;font-family:var(--serif);font-weight:600;font-size:{{ dek_fs }}px;line-height:1.24;letter-spacing:-.008em;color:var(--ink);
  flex:0 1 auto;min-height:0;overflow:hidden;--clamp:12}
.next{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:24px;flex:none;padding:22px 0 26px}
.next span{font-family:var(--mono);font-weight:600;font-size:28px;letter-spacing:.04em;text-transform:uppercase}
.next + .ftr{margin-top:0}
{% endblock %}
{% block body %}
{{ m.rx_band() }}
<div class="frame">
  {{ m.header('Raio-X da cobertura') }}
  {{ rx.locator(s.counts) }}
  {# no Raio-X a cor é do lado (A/B): a editoria entra em chip vazado, para não confundir #}
  <div class="k"><h1 class="sec-title">O fato</h1>{% if s.get('section') %}<span class="chip line">{{ s.section.title }}</span>{% endif %}</div>
  <p class="hl" data-fit="raiox-fato-titulo" data-min="28">{{ m.tx(s.headline) }}</p>
  <p class="dek" data-fit="raiox-fato-dek" data-min="40">{{ m.tx(s.dek) }}</p>
  <div class="next"><span>A seguir: o que cada lado destacou</span>{{ m.go_arrow() }}</div>
  {{ rx.footer_rx() }}
</div>
{% endblock %}
