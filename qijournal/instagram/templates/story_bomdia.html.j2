{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set wx = s.get('weather') %}
{% block theme %}t-dark{% endblock %}
{% block style %}
.hi{margin-top:96px;flex:none}
.hi.solo{margin-top:auto;margin-bottom:auto}
.hi.solo h1{font-size:200px}
.hi h1{font-family:var(--serif);font-weight:800;font-size:176px;line-height:.95;letter-spacing:-.025em}
.hi .d{display:flex;align-items:center;gap:18px;margin-top:30px;font-family:var(--mono);font-weight:600;font-size:48px;letter-spacing:.02em;color:var(--ink)}
.hi .d span{color:var(--orange)}
.panel{margin-top:auto;border:2px solid var(--rule2);background:var(--panel);flex:none}
.panel .ph{display:flex;justify-content:space-between;align-items:center;height:64px;padding:0 26px;border-bottom:2px solid var(--rule)}
.panel .pb{display:flex;align-items:center;gap:36px;padding:34px 30px 30px}
.panel .pb svg{color:#F6F4EF;flex:none}
.temp{font-family:var(--sans);font-weight:800;font-variant-numeric:tabular-nums lining-nums;font-size:150px;line-height:.9;letter-spacing:-.035em}
.temp small{font-size:.4em;letter-spacing:0;vertical-align:top;margin-left:6px;color:var(--ink2)}
.desc{font-family:var(--sans);font-weight:700;font-size:44px;margin-top:14px}
.tmw{margin-left:auto;align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:10px;padding-left:30px;border-left:2px solid var(--rule)}
.tmw svg{color:var(--ink2)}
.tmw b{font-family:var(--mono);font-weight:600;font-size:36px;letter-spacing:-.02em}
.tmw .ds{font-family:var(--sans);font-weight:600;font-size:28px;color:var(--ink2)}
.mm{display:grid;grid-template-columns:1fr 1fr;border-top:2px solid var(--rule)}
.mm div{padding:22px 30px;font-family:var(--mono);font-size:28px;color:var(--ink3);letter-spacing:.05em;text-transform:uppercase}
.mm div+div{border-left:2px solid var(--rule)}
.mm b{display:block;margin-top:6px;font-size:52px;color:var(--ink);font-weight:600;letter-spacing:-.02em;text-transform:none}
.sign{margin-top:auto;flex:none;display:flex;align-items:center;gap:16px;font-family:var(--mono);font-size:28px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}
.panel + .sign{margin-top:48px}
.hi.solo + .sign{margin-top:0}
{% endblock %}
{% block body %}
<div class="frame">
  <div class="hdr">{{ m.logo(360) }}<span class="lbl">Edição da manhã</span></div>
  <div class="hi{{ '' if wx else ' solo' }}">
    <h1>Bom dia</h1>
    <div class="d">{{ m.tri(34) }}<span>{{ s.weekday }}</span>{{ s.date }}</div>
  </div>
  {% if wx %}
  <div class="panel">
    <div class="ph"><span class="lbl">Clima · {{ wx.city }}</span><span class="lbl">agora</span></div>
    <div class="pb">
      {{ m.weather_icon(wx.current_desc, 170) }}
      <div><div class="temp">{{ m.t0(wx.current_c) }}<small>°C</small></div><div class="desc">{{ wx.current_desc }}</div></div>
      {% if wx.tomorrow_min is not none and wx.tomorrow_max is not none %}
      <div class="tmw"><span class="lbl">Amanhã</span>{{ m.weather_icon(wx.tomorrow_desc, 64) }}<b>{{ m.t1(wx.tomorrow_min) }}–{{ m.t1(wx.tomorrow_max) }} °C</b><span class="ds">{{ wx.tomorrow_desc }}</span></div>
      {% endif %}
    </div>
    <div class="mm"><div>Mín. hoje<b>{{ m.t1(wx.today_min) }} °C</b></div><div>Máx. hoje<b>{{ m.t1(wx.today_max) }} °C</b></div></div>
  </div>
  {% endif %}
  <div class="sign">{{ brand.tagline }}</div>
</div>
{% endblock %}
