{# Em 1 minuto 2.0 · fato (§4.5): marinho. Chip da editoria vazado; o número do fato em laranja (180 a 220 px,
   qualificador acima) e a frase em Noto Serif 600 de 52 px (sem número, 60 px), juntos no meio do quadro;
   no pé, a linha do relógio (só no slide 2, quando ele vale), o selo de cobertura com a mini barra A/N/B e as
   fontes. Fato sem matéria casada sai sem selo e sem chip. Sem o "01 FATO": o contador está na faixa. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block theme %}t-dark v2{% endblock %}
{% block style %}
.chip{flex:none;align-self:flex-start;margin-top:28px;height:46px;padding:0 18px;font-size:21px;background:transparent;
  border:2px solid var(--rule3);color:var(--ink)}
.corpo{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;justify-content:center;padding:36px 0 44px}
.corpo .numbox{flex:none;margin-bottom:30px}
.corpo .qual{margin-bottom:.1em;letter-spacing:.02em}
.frase{flex:0 1 auto;min-height:0;overflow:hidden;font-family:var(--serif);font-weight:600;line-height:1.2;letter-spacing:-.01em;
  color:var(--ink);text-wrap:pretty}
.frase.solo{font-weight:700;line-height:1.14;letter-spacing:-.014em;text-wrap:balance}
.base{flex:none;display:flex;flex-direction:column;gap:18px;padding-top:24px;border-top:2px solid var(--rule2)}
.rel{font-family:var(--label);font-stretch:100%;font-weight:600;font-size:26px;line-height:1.35;color:var(--ink)}
.rel .k{font-family:var(--mono);font-weight:600;font-size:20px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2);margin-right:14px}
.rel .h{font-family:var(--mono);font-weight:500;font-size:23px;color:var(--ink2)}
.rel .sep{color:var(--ink3)}
.rel .more{font-family:var(--mono);font-weight:600;font-size:23px;color:var(--ink2)}
.rel .nt{display:block;margin-top:4px;font-family:var(--mono);font-weight:500;font-size:19px;color:var(--ink3)}
.selo-cob .txt{color:var(--ink)}
.fontes{font-family:var(--label);font-stretch:100%;font-weight:600;font-size:24px;line-height:1.35;color:var(--ink2);overflow:hidden;max-height:2.8em}
.fontes .k{font-family:var(--mono);font-weight:600;font-size:20px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-right:8px}
.fontes .more{font-family:var(--mono)}
{% endblock %}
{% block body %}
{{ m.serie_band(s.selo, true, 'em1min') }}
<div class="frame">
  {% if s.editoria %}<span class="chip">{{ s.editoria }}</span>{% endif %}
  <div class="corpo">
    {% if s.valor %}{{ m.num_hero(s.valor, s.qual or none, s.tam, 140, true) }}{% endif %}
    <p class="frase{{ ' solo' if s.solo }}" data-fit="fato-frase" data-min="38" style="font-size:{{ s.tam_frase }}px">{{ m.tx(s.frase) }}</p>
  </div>
  {% if s.relogio or s.cobertura or s.fontes %}
  <div class="base">
    {% if s.relogio %}
    <div class="rel"><span class="k">Relógio</span>{% for b in s.relogio %}<span class="nw">{{ b.nome }} <span class="h">{{ b.hora }}</span>{% if loop.last and s.relogio_mais %} <span class="more">+{{ s.relogio_mais }}</span>{% endif %}</span>{% if not loop.last %} <span class="sep">·</span> {% endif %}{% endfor %}<span class="nt">horário informado por cada veículo, em Brasília</span></div>
    {% endif %}
    {% if s.cobertura %}{{ m.selo_cobertura(s.cobertura, s.cob_a, s.cob_n, s.cob_b) }}{% endif %}
    {% if s.fontes %}<div class="fontes" data-fit="fato-fontes" data-min="20"><span class="k">Fontes</span>{{ m.sources(s.fontes) }}</div>{% endif %}
  </div>
  {% endif %}
</div>
{{ m.assinatura(s.nota) }}
{% endblock %}
