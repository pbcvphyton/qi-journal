{# Número do dia · slide 3, como medimos + CTA (§4.4): o método numa frase, a ficha (fonte, período, base,
   limite), a ordem de escolha com o passo de hoje marcado e o único CTA. Papel. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block theme %}t-paper v2{% endblock %}
{% block style %}
.kicker{flex:none;margin-top:30px;font-family:var(--mono);font-weight:600;font-size:24px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.metodo{flex:none;margin-top:16px;font-family:var(--serif);font-weight:600;font-size:42px;line-height:1.22;letter-spacing:-.005em;
  color:var(--ink);text-wrap:pretty;overflow:hidden;max-height:6.2em}
.ficha{flex:none;margin-top:34px;display:grid;grid-template-columns:174px 1fr;border-top:2px solid var(--rule3)}
.ficha dt,.ficha dd{padding:14px 0 13px;border-bottom:2px solid var(--rule)}
.ficha dt{padding-right:24px}
.ficha dt{font-family:var(--mono);font-weight:600;font-size:21px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2);padding-top:19px}
.ficha dd{font-family:var(--serif);font-size:27px;line-height:1.3;color:var(--ink)}
.cadeia{flex:none;margin-top:32px}
.cadeia h2{font-family:var(--mono);font-weight:600;font-size:21px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2);margin-bottom:10px}
.cadeia ol{list-style:none}
.cadeia li{display:flex;align-items:baseline;gap:14px;font-family:var(--label);font-stretch:100%;font-weight:500;font-size:24px;line-height:1.36;color:var(--ink2)}
.cadeia li b{flex:none;width:28px;font-family:var(--mono);font-weight:600;font-size:22px;color:var(--ink3)}
.cadeia li.on{color:var(--ink);font-weight:700}
.cadeia li.on b{color:var(--accent)}
.cadeia li.on span::after{content:" ← hoje";font-family:var(--mono);font-weight:600;font-size:20px;color:var(--accent)}
.cta{flex:none;margin-top:auto;padding-top:24px;border-top:4px solid var(--ink)}
.cta .hook{font-size:84px;max-height:2.1em}
{% endblock %}
{% block body %}
{{ m.serie_band(s.selo, true, 'numero') }}
<div class="frame">
  <div class="kicker">{{ s.kicker }}</div>
  <p class="metodo" data-fit="metodo" data-min="32">{{ m.tx(s.metodo) }}</p>
  <dl class="ficha" data-fit="ficha" data-min="20">
    {% for f in s.ficha %}<dt>{{ f.k }}</dt><dd>{{ m.tx(f.v) }}</dd>{% endfor %}
  </dl>
  <div class="cadeia">
    <h2>Por que este número · a ordem de escolha</h2>
    <ol>{% for p in s.cadeia %}<li class="{{ 'on' if p.atual else '' }}"><b>{{ p.n }}</b><span>{{ p.texto }}</span></li>{% endfor %}</ol>
  </div>
  <div class="cta"><h2 class="hook" data-fit="cta" data-min="64">{{ s.cta }}</h2></div>
</div>
{{ m.assinatura(s.nota) }}
{% endblock %}
