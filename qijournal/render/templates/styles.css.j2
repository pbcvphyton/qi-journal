  .rat-blocks li{justify-content:flex-start;padding:5px 0 6px 12px;background:transparent;font-size:12px;line-height:1.4}
  .rat-blocks li:last-child:nth-child(4n+1){grid-column:1/-1}
  .rat-blocks li:last-child:nth-child(4n+2),.rat-blocks li:nth-last-child(2):nth-child(4n+1),.rat-blocks li:last-child:nth-child(4n+3){grid-column:span 2}
  .rat-note{font-size:12px}

  /* Cobertura comparada: colunas com réguas finas; em cada linha, títulos, barras e
     conclusões alinhados (subgrade) */
  .cmp-list{grid-template-columns:repeat(3,minmax(0,1fr));column-gap:40px;row-gap:0;margin-top:4px}
  .cmp-i{position:relative;display:grid;grid-row:span 7;grid-template-rows:subgrid;align-content:start;padding:14px 0 16px;border-bottom:none;border-top:1px solid var(--rl)}
  .cmp-i:nth-child(-n+3){border-top:none}
  .cmp-i:not(:nth-child(3n+1))::before{content:"";position:absolute;left:-20px;top:14px;bottom:16px;width:1px;background:var(--rl)}
  .cmp-i>.cov.full{display:contents}
  .cmp-i>.cat{grid-row:1}
  .cmp-i>h3{grid-row:2;margin-bottom:8px;font-size:16px;line-height:1.28}
  .cmp-i .cov-scale{grid-row:3;align-self:end;font-size:11px;line-height:1.3}
  .cmp-i .cov-bar{grid-row:4}
  .cmp-i .cov-lean{grid-row:5}
  .cmp-i .cov-c{grid-row:6;font-size:13.5px;line-height:1.5}
  .cmp-i .cov-who{grid-row:7}
}
