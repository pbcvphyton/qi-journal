  .fp~.tabs-wrap.searching .cl.sp-3{grid-column:span 3}
  .fp~.tabs-wrap.searching .cl.sp-all{grid-column:1/-1}
  .fp~.tabs-wrap.searching .cl.wide{grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;column-gap:28px}
  .fp~.tabs-wrap.searching .cl.wide>.dk{grid-column:2;grid-row:2/-1}
  .fp~.tabs-wrap.searching .cl.wide>.ci{grid-column:3}
  .fp~.tabs-wrap.searching .cl.wide:not(:has(>.ci:not(.img-fail))){display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}

  /* Racional: blocos numa grade de 4 colunas sem vagas vazias (a última linha
     incompleta se fecha); a partir de 1600 px, resumo à esquerda e blocos à direita */
  .rat,.cmp{margin:0 var(--gut);padding:20px 0 26px;border-top:4px double var(--fr)}
  :root[data-theme="dark"] .rat,:root[data-theme="dark"] .cmp{border-top-color:var(--fr)}
