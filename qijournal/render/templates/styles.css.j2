  .fp~.tabs-wrap .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
  .fp~.tabs-wrap.all .cards,.fp~.tabs-wrap.searching .cards{grid-template-columns:minmax(0,1fr)}
  /* Durante a busca, page.js marca os cards que fecham a última linha */
