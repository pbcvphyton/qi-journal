{#- Estilos da página (incluídos inline). Layout do jornal:
    tokens --qi/--qn/--qc/--qr, papel central de 1120px, masthead, ticker na cor da tinta,
    faixa de clima, op-bar, hero 5fr/3fr, destaques numerados, abas, cards e modais.
    As cores da marca vêm de config.brand.colors (já validadas em web.py); os neutros
    são quentes, em torno do off-white #F5F3ED e da tinta #0E1016 do logo PBCV Tech.
    Com brand.masthead, o cabeçalho vira um bloco de cor com o logo em on_masthead. -#}
:root{
  --qi:{{ brand.colors.primary }};--qn:{{ brand.colors.navy }};--qc:{{ brand.colors.accent }};--qr:{{ brand.colors.alert }};
  --up:{{ brand.colors.ticker_up }};--down:{{ brand.colors.ticker_down }};
  --qi-rgb:{{ brand.rgb.primary }};--qn-rgb:{{ brand.rgb.navy }};--qr-rgb:{{ brand.rgb.alert }};
  --ink:#0E1016;--paper:#fff;--bg:#F5F3ED;--rule:#DAD5CA;--rl:#EAE6DE;
  --head:var(--qn);--body:#45413A;--muted:#5A564C;--mute2:#67625A;--faint:#6F6A60;
  --soft:#FAF9F6;--side:#FDFCFA;--hover:#F8F7FF;--hl:#EFEDFB;--op-a:#FAF9F6;--op-b:#F5F3ED;
  --link:var(--qi);--text:#36332D;
  --fx-dot:var(--qi);--fx-line:var(--qc);
  --sf:'Noto Serif',Georgia,'Times New Roman',serif;
  --ss:'Noto Sans',Helvetica,Arial,sans-serif;
  --mn:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color-scheme:light;
}
:root[data-theme="dark"]{
  --ink:#F5F3ED;--paper:#0E1016;--bg:#07080B;--rule:#2B2E38;--rl:#1D2029;
  --head:#F5F3ED;--body:#B8B3A8;--muted:#A39E93;--mute2:#958F84;--faint:#8A8479;
  --soft:#13151C;--side:#111318;--hover:#171A26;--hl:#1E2033;--op-a:#161827;--op-b:#0E1016;
  --link:#A59CFF;--text:#D9D5CB;
  color-scheme:dark;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--sf);-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.4}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--link);outline-offset:2px}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:8px;z-index:10000;padding:8px 14px;background:var(--paper);color:var(--link);font-family:var(--ss);font-size:13px;font-weight:700;border:2px solid var(--qi)}
.skip:focus{left:16px}
.paper{max-width:1120px;margin:0 auto;background:var(--paper);box-shadow:0 0 60px rgba(var(--qn-rgb),.08)}
:root[data-theme="dark"] .paper{box-shadow:0 0 60px rgba(0,0,0,.5)}

/* Barra de progresso de leitura */
#rdprog{position:fixed;top:0;left:0;right:0;height:3px;background:var(--qc);transform:scaleX(0);transform-origin:0 50%;z-index:9999;pointer-events:none}

/* Cabeçalho */
.mast-wrap{position:relative;overflow:hidden;background:var(--paper);border-bottom:3px solid var(--qn)}
:root[data-theme="dark"] .mast-wrap{border-bottom-color:var(--qi)}
#mast-canvas{position:absolute;inset:0;width:100%;height:100%;opacity:.07;pointer-events:none}
:root[data-theme="dark"] #mast-canvas{opacity:.09}
.mast{position:relative;z-index:2;text-align:center;padding:28px 40px 22px}
.mast h1{font-family:var(--ss);font-size:48px;font-weight:800;letter-spacing:-1px;line-height:1.15;color:var(--qn)}
.mast h1 a{display:inline-block}
.mast h1:focus{outline:none}
.mast h1 .q{color:var(--qc)}
.mast h1 .journal{font-weight:900;margin-left:4px}
:root[data-theme="dark"] .mast h1{color:var(--head)}
.mast h1.logo{line-height:0}
.mast h1.logo svg{display:block;height:116px;width:auto;margin:0 auto}
:root[data-theme="dark"] .mast h1.logo:not(.mono):not(.duo) svg{filter:invert(1) hue-rotate(180deg) brightness(1.15)}
/* Logo com versão própria para o modo escuro: troca de SVG em vez de filtro */
.mast h1.logo .lg{display:block}
.mast h1.logo .lg-d,:root[data-theme="dark"] .mast h1.logo .lg-l{display:none}
:root[data-theme="dark"] .mast h1.logo .lg-d{display:block}
{% if brand.logo_height %}
.mast h1.logo svg,.mast h1.logo.mono svg{height:{{ brand.logo_height }}px;max-width:100%}
{% endif %}
.mast h1.logo.mono svg{height:64px;color:var(--qn)}
:root[data-theme="dark"] .mast h1.logo.mono svg{color:var(--head)}
.mast-sub{font-family:var(--ss);font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--mute2);margin-top:6px}
.mast h1.logo+.mast-sub{margin-top:14px}
.mast-date{font-family:var(--mn);font-size:10px;color:var(--faint);margin-top:8px;letter-spacing:1px}
{% if brand.masthead %}
/* Cabeçalho em bloco de cor (brand.masthead): logo, slogan, data e botões em on_masthead */
.mast-wrap.solid{--mh:{{ brand.masthead }};--on-mh:{{ brand.on_masthead }};--on-mh-rgb:{{ brand.rgb.on_masthead }};--fx-dot:var(--on-mh);--fx-line:var(--on-mh);background:var(--mh);background:linear-gradient(135deg,color-mix(in srgb,var(--mh) 94%,#fff),color-mix(in srgb,var(--mh) 92%,#000))}
:root[data-theme="dark"] .mast-wrap.solid{border-bottom-color:var(--qn);background:color-mix(in srgb,var(--mh) 82%,#000)}
.mast-wrap.solid #mast-canvas{opacity:.1}
.mast-wrap.solid .mast h1,.mast-wrap.solid .mast h1.logo svg{color:var(--on-mh)}
.mast-wrap.solid .mast-sub{color:rgba(var(--on-mh-rgb),.8)}
.mast-wrap.solid .mast-date{color:rgba(var(--on-mh-rgb),.72)}
.mast-wrap.solid .tool{background:transparent;border-color:rgba(var(--on-mh-rgb),.4);color:var(--on-mh)}
.mast-wrap.solid .tool:hover{border-color:var(--on-mh);background:rgba(var(--on-mh-rgb),.1)}
.mast-wrap.solid :focus-visible{outline-color:var(--on-mh)}
{% endif %}
.mast-tools{position:absolute;top:14px;right:16px;z-index:3;display:flex;gap:6px}
.tool{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--mn);font-size:9.5px;letter-spacing:1px;text-transform:uppercase;color:var(--mute2);cursor:pointer;transition:border-color .25s,color .25s}
.tool:hover{border-color:var(--link);color:var(--link)}
.tool svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.tool .i-sun{display:none}
:root[data-theme="dark"] .tool .i-sun{display:block}
:root[data-theme="dark"] .tool .i-moon{display:none}

/* Ticker de cotações */
.tk{position:relative;background:var(--qn);font-family:var(--mn);font-size:10.5px;color:rgba(255,255,255,.62);overflow:hidden}
:root[data-theme="dark"] .tk{background:#07080B}
.tk-track{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;row-gap:3px;padding:8px 20px}
.tk-i{white-space:nowrap}
.tk-i+.tk-i::before,.tk.run .tk-i::before{content:"·";color:rgba(255,255,255,.3);margin:0 10px}
.tk-i b{color:#fff;font-weight:500;margin-left:2px}
.tk .u{color:var(--up)}
.tk .d{color:var(--down)}
.tk .f{color:rgba(255,255,255,.62)}
.tk.run .tk-rail{display:flex;width:max-content;animation:tk-scroll var(--tk-dur,60s) linear infinite}
.tk.run .tk-track{flex-wrap:nowrap;justify-content:flex-start;padding:8px 0}
.tk.run:hover .tk-rail,.tk.run:focus-within .tk-rail,.tk.paused .tk-rail{animation-play-state:paused}
@keyframes tk-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.tk-pause{position:absolute;top:0;right:0;bottom:0;width:44px;padding-left:12px;border:none;background:linear-gradient(90deg,rgba(var(--qn-rgb),0),var(--qn) 45%);color:rgba(255,255,255,.75);font-size:10px;letter-spacing:-1px;cursor:pointer}
.tk-pause:hover{color:#fff}
:root[data-theme="dark"] .tk-pause{background:linear-gradient(90deg,rgba(7,8,11,0),#07080B 45%)}
.tk-pause[hidden]{display:none}

/* Faixa de clima */
.wx{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 28px;padding:6px 20px;background:var(--soft);font-family:var(--mn);font-size:10px;color:var(--mute2);border-bottom:1px solid var(--rl)}
.wx p{white-space:nowrap}
.wx strong{color:var(--ink);font-weight:600;margin:0 6px 0 4px}
.wx .sep{color:var(--rule);margin:0 6px}

/* Editorial do dia */
.op-bar{padding:18px 32px;background:linear-gradient(135deg,var(--op-a),var(--op-b));border-bottom:1px solid var(--rl);font-size:15px;font-style:italic;color:var(--body);line-height:1.7;text-align:center}
.op-bar p{max-width:880px;margin:0 auto}
.op-bar strong{color:var(--ink)}

/* Rótulo de seção (Em 1 minuto, Destaques…) */
.kicker{font-family:var(--ss);font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;color:var(--link);margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid var(--qi)}

/* Em 1 minuto */
.brief{padding:16px 30px 18px;border-bottom:1px solid var(--rl)}
.brief ul{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 32px}
.brief li{position:relative;padding-left:16px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
.brief li::before{content:"";position:absolute;left:0;top:.5em;width:6px;height:6px;border-radius:1px;background:var(--qc)}
.brief strong{color:var(--ink)}

/* Área clicável: o link do título cobre o bloco inteiro */
.hit::after{content:"";position:absolute;inset:0;z-index:1}
.hit:focus-visible{outline:none}
.hero-l,.ss,.cl,.dst li{position:relative}
.hero-l:has(.hit:focus-visible),.ss:has(.hit:focus-visible),.cl:has(.hit:focus-visible),.dst li:has(.hit:focus-visible){outline:2px solid var(--link);outline-offset:-3px}
.cat{font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:5px;color:var(--sc,var(--qi))}
:root[data-theme="dark"] .cat,:root[data-theme="dark"] .mcat{color:#B4ACFF;color:color-mix(in srgb,var(--sc,var(--qi)) 50%,#fff)}
.meta{font-family:var(--mn);font-size:9px;color:var(--faint);margin-top:8px;text-transform:uppercase;letter-spacing:.5px;line-height:1.5}
.meta>*+*::before{content:"·";margin:0 6px}
figure[data-img]{overflow:hidden;border-radius:3px;background:var(--soft)}
figure[data-img] img{width:100%;height:100%;object-fit:cover}
figure.img-fail{display:none}
:root[data-theme="dark"] figure[data-img] img{filter:brightness(.9)}

/* Manchete + chamadas */
.hero{display:grid;grid-template-columns:5fr 3fr;border-bottom:2px solid var(--qn)}
.hero.solo{grid-template-columns:1fr}
.hero-l{padding:26px 30px;border-right:1px solid var(--rule);cursor:pointer;transition:background .3s}
.hero.solo .hero-l{border-right:none}
.hero-l:hover{background:var(--hover)}
.hero-l h2{font-size:clamp(22px,3.2vw,34px);font-weight:900;line-height:1.12;margin-bottom:14px;letter-spacing:-.5px;color:var(--head)}
.hero-l .dek{font-family:var(--ss);font-size:15px;color:var(--body);line-height:1.6;margin-bottom:16px}
.hero-l .hi{height:260px;margin-bottom:16px}
.hero-l .sub{font-family:var(--ss);font-size:13.5px;color:var(--body);line-height:1.65;margin-bottom:10px}
.hero-l .sub strong{color:var(--ink)}
.hero-l .more{display:none}
.hero-l:not(:has(.hi)) .more,.hero-l:has(.hi.img-fail) .more{display:block}
.hero-l .rd{font-family:var(--ss);font-size:10px;color:var(--link);font-weight:700;letter-spacing:.5px;margin-top:12px}
.hero-r{display:flex;flex-direction:column}
.hero-r .ss{flex:1;padding:18px 22px;border-bottom:1px solid var(--rule);cursor:pointer;transition:background .3s;display:flex;flex-direction:column;justify-content:center}
.hero-r .ss:last-child{border-bottom:none}
.hero-r .ss:hover{background:var(--hover)}
.hero-r .ss h3{font-size:16px;font-weight:700;line-height:1.24;margin-bottom:6px;color:var(--ink)}
.hero-r .ss>p:not(.cat):not(.meta){font-family:var(--ss);font-size:12px;color:var(--muted);line-height:1.5}

/* Destaques numerados */
.dst{padding:14px 30px 16px;background:linear-gradient(135deg,var(--soft),var(--paper));border-bottom:1px solid var(--rl)}
.dst ol{list-style:none;counter-reset:t;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
.dst li{counter-increment:t;display:flex;gap:10px;padding:9px 12px 9px 0;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:13px;line-height:1.4;border-radius:3px;cursor:pointer;transition:background .2s}
.dst li:hover{background:var(--hl)}
.dst li::before{content:counter(t);font-family:var(--sf);font-size:22px;font-weight:900;color:var(--link);min-width:20px;line-height:1}
.dst li:nth-child(odd){border-right:1px solid var(--rl)}
.dst li:nth-child(even){padding-left:12px}
.dst li:last-child:nth-child(odd){grid-column:1/-1;border-right:none}
.dst li>div{min-width:0}
.dst .dst-cat{display:block;margin-top:3px;font-family:var(--mn);font-size:8.5px;text-transform:uppercase;letter-spacing:1px;color:var(--faint)}

/* Busca */
.srch{display:flex;align-items:center;gap:12px;padding:10px 30px;background:var(--paper);border-top:2px solid var(--qn)}
.srch-label{font-family:var(--mn);font-size:9.5px;letter-spacing:1px;color:var(--faint);text-transform:uppercase;flex-shrink:0}
.srch-input{flex:1;min-width:0;max-width:420px;height:34px;padding:0 16px;border:1.5px solid var(--rl);border-radius:20px;font-family:var(--ss);font-size:13px;color:var(--ink);background:var(--bg);outline:none;transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;appearance:none}
.srch-input:focus{border-color:var(--qi);box-shadow:0 0 0 3px rgba(var(--qi-rgb),.15)}
.srch-input::placeholder{color:var(--faint)}
.srch-count{margin-left:auto;font-family:var(--mn);font-size:9.5px;color:var(--link);flex-shrink:0}
.no-res{padding:40px 22px;text-align:center;font-family:var(--ss);font-size:14px;color:var(--muted)}
.no-res[hidden]{display:none}

/* Abas por seção */
.tabs-bar{display:flex;overflow-x:auto;background:var(--soft);border-top:1px solid var(--rl);border-bottom:2px solid var(--rl);scrollbar-width:none;-webkit-overflow-scrolling:touch}
.tabs-bar::-webkit-scrollbar{display:none}
.tab-btn{flex-shrink:0;margin-bottom:-2px;padding:12px 18px;border:none;border-bottom:3px solid var(--sc,var(--qi));background:transparent;font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;white-space:nowrap;color:var(--mute2);cursor:pointer;transition:background .25s,color .25s}
.tab-btn:hover{color:var(--ink);background:var(--paper)}
.tab-btn[aria-selected="true"]{color:var(--ink);background:var(--paper)}
.tab-btn .n{margin-left:4px;font-family:var(--mn);font-size:9px;font-weight:500;letter-spacing:0;color:var(--faint)}
.tab-btn:focus-visible{outline-offset:-3px}
@media (min-width:900px){.tab-btn{padding:12px 11px;letter-spacing:.8px}.tabs-bar{flex-wrap:wrap}}
.tabs-wrap.searching .tab-btn[aria-selected="true"]{color:var(--mute2);background:transparent}
.tabs-nav{position:relative}
.tabs-arrow{position:absolute;top:0;bottom:2px;z-index:2;width:40px;border:none;font-family:var(--ss);font-size:22px;line-height:1;color:var(--ink);cursor:pointer}
.tabs-arrow.prev{left:0;padding-right:12px;background:linear-gradient(90deg,var(--soft) 55%,transparent)}
.tabs-arrow.next{right:0;padding-left:12px;background:linear-gradient(270deg,var(--soft) 55%,transparent)}
.tabs-arrow:hover{color:var(--link)}
.tabs-arrow[hidden]{display:none}
:root[data-theme="dark"] .tab-btn{border-bottom-color:color-mix(in srgb,var(--sc,var(--qi)) 60%,#fff)}
.tab-layout{display:flex;align-items:stretch}
.tab-main{flex:7;min-width:0;border-right:1px solid var(--rl)}
.tab-side{flex:3;min-width:0;position:relative;min-height:460px;background:var(--side)}
.pane-hd{display:none;padding:16px 22px 8px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--sc,var(--qi));border-bottom:2px solid var(--sc,var(--qi))}
:root[data-theme="dark"] .pane-hd{color:color-mix(in srgb,var(--sc,var(--qi)) 50%,#fff)}
.js .tab-pane{display:none}
.js .tab-pane.active,.js .tabs-wrap.searching .tab-pane{display:block}
.js .tabs-wrap.searching .tab-pane.empty{display:none}
.tabs-wrap.all .pane-hd,.tabs-wrap.searching .pane-hd,html:not(.js) .pane-hd{display:block}
html:not(.js) .tabs-bar{display:none}
.tabs-wrap.searching .cl.is-hidden{display:none}

/* Cards */
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden;padding-bottom:1px}
.cl{padding:18px 22px;background:var(--paper);box-shadow:1px 0 0 var(--rl),0 1px 0 var(--rl);cursor:pointer;transition:background .35s cubic-bezier(.23,1,.32,1),transform .35s cubic-bezier(.23,1,.32,1),box-shadow .35s cubic-bezier(.23,1,.32,1)}
.tabs-wrap:not(.searching) .cl:last-child:nth-child(odd){grid-column:1/-1}
.cl:hover{background:var(--hover);transform:translateY(-2px);box-shadow:1px 0 0 var(--rl),0 1px 0 var(--rl),0 8px 30px rgba(var(--qi-rgb),.08);z-index:5}
:root[data-theme="dark"] .cl:hover{box-shadow:1px 0 0 var(--rl),0 1px 0 var(--rl),0 8px 30px rgba(0,0,0,.3)}
.cl .ci{height:140px;margin-bottom:10px}
.tabs-wrap:not(.searching) .cl:last-child:nth-child(odd) .ci{height:200px}
.cl h3{font-size:16px;font-weight:700;line-height:1.24;margin-bottom:8px;color:var(--ink)}
.cl .dk{font-family:var(--ss);font-size:12.5px;color:var(--muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}

/* Radar (coluna lateral) */
/* O radar acompanha a altura da coluna principal e rola por dentro quando não cabe. */
.radar{position:absolute;inset:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;padding:24px 20px}
.radar-hd{display:flex;align-items:center;gap:8px;margin-bottom:18px;padding-bottom:8px;border-bottom:2px solid var(--qn);font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
:root[data-theme="dark"] .radar-hd{border-bottom-color:var(--qi)}
.radar-hd::before{content:"";width:6px;height:6px;flex-shrink:0;border-radius:50%;background:var(--qr);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(var(--qr-rgb),.4)}70%{box-shadow:0 0 0 5px rgba(var(--qr-rgb),0)}100%{box-shadow:0 0 0 0 rgba(var(--qr-rgb),0)}}
.radar-list{list-style:none;display:flex;flex-direction:column;gap:14px}
.radar-list li{padding-bottom:14px;border-bottom:1px dashed var(--rl)}
.radar-list li:last-child{padding-bottom:0;border-bottom:none}
.radar-item{display:block;transition:opacity .2s}
.radar-item:hover{opacity:.65}
.radar-item .tm{font-family:var(--mn);font-size:9.5px;font-weight:600;color:var(--link)}
.radar-item .src{margin-left:6px;font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;color:var(--mute2)}
.radar-item .tt{display:block;margin-top:5px;font-family:var(--sf);font-size:13.5px;font-weight:600;line-height:1.35;color:var(--ink)}

/* Modal da matéria */
body.modal-open{overflow:hidden}
.mo{display:none;position:fixed;inset:0;z-index:1000;overflow-y:auto;overscroll-behavior:contain;padding:40px 20px;background:rgba(var(--qn-rgb),.5);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
:root[data-theme="dark"] .mo{background:rgba(0,0,0,.6)}
.mo.on,html:not(.js) .mo:target{display:flex;justify-content:center;align-items:flex-start}
.ml{position:relative;width:100%;max-width:700px;padding:40px 44px;background:var(--paper);border-top:4px solid var(--sc,var(--qi));box-shadow:0 20px 60px rgba(var(--qn-rgb),.2);animation:ml-in .35s cubic-bezier(.2,.9,.3,1.15)}
:root[data-theme="dark"] .ml{background:#14161E}
.ml:focus{outline:none}
@keyframes ml-in{from{opacity:0;transform:translateY(28px) scale(.97)}to{opacity:1;transform:none}}
/* O × acompanha a rolagem do modal (.mo é o contêiner que rola): matéria longa aberta pelo e-mail não o esconde. */
.mc{position:sticky;top:8px;float:right;z-index:2;margin:-28px -30px 0 0;width:36px;height:36px;border:none;border-radius:50%;background:var(--paper);font-family:var(--ss);font-size:26px;line-height:1;color:var(--faint);cursor:pointer;transition:color .2s,background .2s}
:root[data-theme="dark"] .mc{background:#14161E}
.mback{margin-top:22px;text-align:center}
.mc2{padding:9px 18px;border:1.5px solid var(--rl);border-radius:20px;background:transparent;font-family:var(--ss);font-size:12px;font-weight:700;letter-spacing:.5px;color:var(--link);cursor:pointer}
.mc2:hover{border-color:var(--link)}
.mc:hover{color:var(--ink);background:var(--soft)}
.ml .mcat{font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;margin-bottom:8px;color:var(--sc,var(--qi))}
.ml h2{padding-right:24px;font-size:26px;font-weight:900;line-height:1.2;margin-bottom:12px;color:var(--head)}
.ml .mdek{font-family:var(--ss);font-size:15px;line-height:1.6;color:var(--body)}
.ml .mhd{padding-bottom:14px;margin-bottom:20px;border-bottom:2px solid var(--qi)}
.ml .mi{margin-bottom:20px;max-height:380px}
.ml .bt p{font-family:var(--ss);font-size:15px;line-height:1.8;color:var(--text)}
.ml .bt p+p{margin-top:14px}
.ml .bt strong{color:var(--ink)}
.ml .why{margin-top:22px;padding:14px 18px;background:var(--soft);border-left:3px solid var(--qc)}
.ml .why h3,.ml .bb h3{font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint);margin-bottom:6px}
.ml .why p{font-family:var(--sf);font-size:15px;font-style:italic;line-height:1.6;color:var(--ink)}
.ml .bb{margin-top:24px;padding-top:14px;border-top:1px solid var(--rl)}
.ml .bb ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px 18px}
.ml .bb a,.ml .bb span{font-family:var(--mn);font-size:11.5px;color:var(--link)}
.ml .bb span{color:var(--muted)}
.ml .bb a:hover{color:var(--qr);text-decoration:underline}
.ml .mtime{margin-top:16px;font-family:var(--mn);font-size:10px;color:var(--faint);letter-spacing:.5px}

/* Cobertura comparada: lado A à esquerda, neutros no meio, lado B à direita */
:root{--cov-a:var(--qi);--cov-b:#C8631A;--cov-n:#CFC9BC}
:root[data-theme="dark"]{--cov-a:#8C80FF;--cov-b:#FF8A5C;--cov-n:#4A4D58}
.cov-bar{display:flex;gap:2px;height:8px;border-radius:4px;overflow:hidden;background:var(--rl)}
.cov-bar span{display:block;height:100%;min-width:4px}
.cov-a{background:var(--cov-a)}
.cov-n{background:var(--cov-n)}
.cov-b{background:var(--cov-b)}
.cov.mini{margin-top:10px}
.cov.mini .cov-bar{height:5px}
.cov-lean{margin-top:5px;font-family:var(--mn);font-size:9px;letter-spacing:.3px;line-height:1.45;color:var(--mute2)}
.cov-lean::before,.cov-sa::before,.cov-sb::after{content:"";display:inline-block;width:7px;height:7px;border-radius:2px;background:var(--cov-n)}
.cov-lean::before{margin-right:6px}
.lean-a .cov-lean::before,.cov-sa::before{background:var(--cov-a)}
.lean-b .cov-lean::before,.cov-sb::after{background:var(--cov-b)}
.lean-equilibrio .cov-lean::before{background:linear-gradient(90deg,var(--cov-a) 50%,var(--cov-b) 50%)}
.cov.full .cov-lean{font-size:10px;font-weight:600;color:var(--ink)}
.cov-scale{display:flex;justify-content:space-between;gap:16px;margin-bottom:6px;font-family:var(--ss);font-size:11.5px;font-weight:600;line-height:1.35;color:var(--ink)}
.cov-sa::before{margin-right:6px}
.cov-sb{text-align:right}
.cov-sb::after{margin-left:6px}
.cov-scale b{font-family:var(--mn);font-weight:600;color:var(--mute2)}
.cov-c{margin-top:8px;font-family:var(--sf);font-size:14.5px;font-style:italic;line-height:1.55;color:var(--ink)}
.cov-who{margin-top:10px}
.cov-who summary{cursor:pointer;font-family:var(--ss);font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--link)}
.cov-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 20px;margin-top:10px}
.cov-col.cn:only-child,.cov-col.cn:nth-child(3){grid-column:1/-1}
.cov-col h4{margin-bottom:6px;padding-bottom:4px;border-bottom:2px solid var(--cov-n);font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--mute2)}
.cov-col.ca h4{border-bottom-color:var(--cov-a)}
.cov-col.cb h4{border-bottom-color:var(--cov-b)}
.cov-col h4 span{font-family:var(--mn);font-weight:500}
.cov-col ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.cov-col li{font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body)}
.cov-col a,.cov-col b{font-weight:700;color:var(--ink)}
.cov-col a:hover{color:var(--link);text-decoration:underline}
.cov-f{color:var(--muted)}
.ml .mcov{margin-top:22px;padding:16px 18px;border:1px solid var(--rl);border-radius:4px;background:var(--soft)}
.ml .mcov>h3{margin-bottom:10px;font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint)}
.cmp{padding:22px 30px 30px;border-top:2px solid var(--qn);background:var(--paper)}
:root[data-theme="dark"] .cmp{border-top-color:var(--qi)}
.cmp-note{max-width:860px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.cmp-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px;margin-top:6px}
.cmp-i{padding:16px 0;border-bottom:1px solid var(--rl)}
.cmp-i h3{margin-bottom:8px;font-size:17px;font-weight:700;line-height:1.3;color:var(--ink)}
.cmp-i h3 a:hover{color:var(--link);text-decoration:underline}
.cmp-t{font-weight:500;letter-spacing:.5px;color:var(--faint)}

/* Rodapé */
.ft{background:var(--qn);padding:20px 28px;text-align:center;font-family:var(--mn);font-size:9.5px;letter-spacing:1.5px;line-height:1.8;color:rgba(255,255,255,.62);text-transform:uppercase}
:root[data-theme="dark"] .ft{background:#07080B;border-top:1px solid var(--rl)}
.ft strong{color:var(--qc)}
.ft a{color:#fff;border-bottom:1px solid rgba(255,255,255,.3);transition:border-color .2s}
.ft a:hover{border-bottom-color:var(--qc)}
.ft-links{margin-top:6px}
.ft details{max-width:960px;margin:14px auto 0;text-align:left}
.ft summary{cursor:pointer;text-align:center;color:rgba(255,255,255,.8)}
.ft summary:hover{color:#fff}
.src-list{list-style:none;margin-top:12px;columns:3 220px;column-gap:28px;text-transform:none;letter-spacing:.2px;font-size:10.5px}
.src-list li{break-inside:avoid;padding:2px 0 2px 14px;position:relative}
.src-list .dot{position:absolute;left:0;top:.55em;width:7px;height:7px;border-radius:50%;background:var(--qc)}
.src-list .st-parcial .dot{background:#F5B83D}
.src-list .st-erro .dot{background:var(--qr)}
.src-list .nf{color:rgba(255,255,255,.45)}
.src-list em{font-style:normal;color:#FFB59A}

/* Voltar ao topo */
.btt{position:fixed;right:24px;bottom:24px;z-index:998;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border:none;border-radius:50%;background:var(--qi);color:#fff;cursor:pointer;box-shadow:0 4px 18px rgba(var(--qi-rgb),.4);opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .3s,transform .3s,visibility .3s,background .3s}
.btt.show{opacity:1;visibility:visible;transform:none}
.btt:hover{background:var(--qn)}
.btt svg{width:18px;height:18px;fill:currentColor}
body.modal-open .btt{visibility:hidden}

/* Arquivo de edições */
.arch{padding:24px 30px 36px;min-height:40vh}
.arch-top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap}
.arch-top .kicker{flex:1}
.arch-home{font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.arch-home:hover{text-decoration:underline}
.arch-m{margin:22px 0 4px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
.arch-list{list-style:none}
.arch-list li{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--rl)}
.arch-list a{flex:1;display:flex;gap:18px;align-items:baseline;padding:11px 8px 11px 0;min-width:0;transition:background .2s}
.arch-list a:hover{background:var(--hover)}
.arch-list time{flex:0 0 250px;font-family:var(--mn);font-size:11px;color:var(--mute2)}
.arch-t{font-size:15px;font-weight:700;line-height:1.3;color:var(--ink)}
.badge{flex-shrink:0;padding:1px 6px;border:1px solid var(--rule);border-radius:10px;font-family:var(--mn);font-size:8.5px;letter-spacing:1px;color:var(--faint)}
.arch-empty{padding:30px 0;font-family:var(--ss);color:var(--muted)}

@media (max-width:760px){
  .paper{box-shadow:none}
  .mast{padding:52px 16px 18px}
  .mast h1{font-size:36px}
  .mast h1.logo svg{height:92px}
  .mast h1.logo.mono svg{height:46px}
  {% if brand.logo_height %}.mast h1.logo svg,.mast h1.logo.mono svg{height:{{ (brand.logo_height * 0.72)|round|int }}px}{% endif %}
  .mast-tools{top:12px;right:12px;left:12px;justify-content:flex-end}
  .tool{height:26px;padding:0 10px}
  .wx{justify-content:flex-start;padding:6px 16px;gap:2px 20px;white-space:normal}
  .wx p{white-space:normal}
  .op-bar{padding:16px 16px;font-size:14.5px}
  .brief{padding:14px 16px 16px}
  .brief ul{grid-template-columns:1fr}
  .hero{grid-template-columns:1fr}
  .hero-l{padding:20px 16px;border-right:none;border-bottom:1px solid var(--rule)}
  .hero-l .hi{height:200px}
  .hero-r .ss{padding:16px}
  .dst{padding:14px 16px}
  .dst ol{grid-template-columns:1fr}
  .dst li,.dst li:nth-child(even){padding:9px 0}
  .dst li:nth-child(odd){border-right:none}
  .srch{padding:10px 16px}
  .srch-label{display:none}
  .srch-input{max-width:none}
  .tab-btn{padding:12px 14px}
  .tab-layout{flex-direction:column}
  .tab-main{border-right:none}
  .cards{grid-template-columns:1fr}
  .cl{padding:16px}
  .cl .ci,.tabs-wrap:not(.searching) .cl:last-child:nth-child(odd) .ci{height:180px}
  .pane-hd{padding:14px 16px 8px}
  .tab-side{border-top:2px solid var(--rl)}
  .tab-side{min-height:0}
  .radar{position:static;overflow:visible;padding:20px 16px}
  .mo{padding:0}
  .ml{min-height:100%;padding:28px 18px 32px;border-top-width:4px}
  .ml h2{font-size:22px}
  .mc{margin:-20px -8px 0 0}
  .ft{padding:18px 16px}
  .arch{padding:18px 16px 28px}
  .cmp{padding:18px 16px 24px}
  .cmp-list{grid-template-columns:1fr}
  .ml .mcov{padding:14px}
  .cov-cols{grid-template-columns:1fr}
  .arch-list a{flex-direction:column;gap:2px}
  .arch-list time{flex:none}
  .btt{right:16px;bottom:16px}
}
@media (max-width:420px){
  .mast h1{font-size:32px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  .cl:hover{transform:none}
}
@media print{
  body{background:#fff}
  #rdprog,#mast-canvas,.mast-tools,.tk-pause,.srch,.tabs-bar,.tab-side,.btt,.modals{display:none!important}
  .paper{box-shadow:none;max-width:none}
  .js .tab-pane,.pane-hd{display:block!important}
  .tk.run .tk-rail{animation:none}
}
