{#- Estilos da página (incluídos inline). Layout do jornal:
    tokens --qi/--qn/--qc/--qr, papel na largura toda da tela, masthead, ticker na cor da
    tinta, faixa de clima, op-bar, hero 5fr/3fr, destaques numerados, abas, cards e modais.
    Em telas largas as margens (--gut), as colunas e as letras crescem por faixas (fim do
    arquivo), de modo que a página ocupa o monitor inteiro sem esticar as linhas de texto.
    As cores da marca vêm de config.brand.colors (já validadas em web.py); os neutros
    são os cinzas azulados do layout original (QI Journal), que casam com o marinho
    e o cobalto da marca Triangula. Com brand.masthead, o cabeçalho vira um bloco de
    cor com o logo em on_masthead. -#}
:root{
  --qi:{{ brand.colors.primary }};--qn:{{ brand.colors.navy }};--qc:{{ brand.colors.accent }};--qr:{{ brand.colors.alert }};
  --up:{{ brand.colors.ticker_up }};--down:{{ brand.colors.ticker_down }};
  --qi-rgb:{{ brand.rgb.primary }};--qn-rgb:{{ brand.rgb.navy }};--qr-rgb:{{ brand.rgb.alert }};
  --ink:#1a2332;--paper:#fff;--bg:#f0f2f5;--rule:#d0d5dd;--rl:#e4e7ec;
  --head:var(--qn);--body:#4a5568;--muted:#5a6577;--mute2:#5f6b7e;--faint:#626e81;
  --soft:#f8f9fb;--side:#fdfdfd;--hover:#fafbff;--hl:#e8ebf0;--op-a:#fafbff;--op-b:#f0f2f5;
  --link:var(--qi);--text:#333d4d;
  --gut:30px;
  --fx-dot:var(--qi);--fx-line:var(--qc);
  --sf:'Noto Serif',Georgia,'Times New Roman',serif;
  --ss:'Noto Sans',Helvetica,Arial,sans-serif;
  --mn:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color-scheme:light;
}
:root[data-theme="dark"]{
  --ink:#e2e8f4;--paper:#111827;--bg:#0b0f17;--rule:#2d3748;--rl:#1f2937;
  --head:#e8edf7;--body:#a9b4c6;--muted:#97a3b6;--mute2:#8a96a8;--faint:#7d8899;
  --soft:#131c2d;--side:#0f1522;--hover:#1a2235;--hl:#1e2d47;--op-a:#1a2235;--op-b:#111827;
  --link:#8fb0f5;--text:#c8d3e6;
  color-scheme:dark;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--sf);-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.4}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--link);outline-offset:2px}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip{position:absolute;left:-9999px;top:8px;z-index:10000;padding:8px 14px;background:var(--paper);color:var(--link);font-family:var(--ss);font-size:13px;font-weight:700;border:2px solid var(--qi)}
.skip:focus{left:16px}
.paper{width:100%;min-height:100vh;display:flex;flex-direction:column;background:var(--paper)}
.paper>main{flex:1}

/* Barra de progresso de leitura */
#rdprog{position:fixed;top:0;left:0;right:0;height:3px;background:var(--qc);transform:scaleX(0);transform-origin:0 50%;z-index:9999;pointer-events:none}

/* Cabeçalho */
.mast-wrap{position:relative;overflow:hidden;background:var(--paper);border-bottom:3px solid var(--qn)}
:root[data-theme="dark"] .mast-wrap{border-bottom-color:var(--qi)}
#mast-canvas{position:absolute;inset:0;width:100%;height:100%;opacity:.07;pointer-events:none}
:root[data-theme="dark"] #mast-canvas{opacity:.09}
.mast{position:relative;z-index:2;text-align:center;padding:28px 40px 22px}
.mast h1{font-family:var(--ss);font-size:48px;font-weight:800;letter-spacing:-1px;line-height:1.15;color:var(--qn)}
.mast h1 a{display:inline-block}
.mast h1:focus{outline:none}
.mast h1 .q{color:var(--qc)}
.mast h1 .journal{font-weight:900;margin-left:4px}
:root[data-theme="dark"] .mast h1{color:var(--head)}
.mast h1.logo{line-height:0}
.mast h1.logo svg{display:block;height:116px;width:auto;margin:0 auto}
:root[data-theme="dark"] .mast h1.logo:not(.mono):not(.duo) svg{filter:invert(1) hue-rotate(180deg) brightness(1.15)}
/* Logo com versão própria para o modo escuro: troca de SVG em vez de filtro */
.mast h1.logo .lg{display:block}
.mast h1.logo .lg-d,:root[data-theme="dark"] .mast h1.logo .lg-l{display:none}
:root[data-theme="dark"] .mast h1.logo .lg-d{display:block}
.mast h1.logo.mono svg{height:64px;color:var(--qn)}
:root[data-theme="dark"] .mast h1.logo.mono svg{color:var(--head)}
{% if brand.logo_height %}
.mast h1.logo svg,.mast h1.logo.mono svg{height:{{ brand.logo_height }}px;max-width:100%}
{% endif %}
.mast-sub{font-family:var(--ss);font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--mute2);margin-top:6px}
.mast h1.logo+.mast-sub{margin-top:14px}
.mast-date{font-family:var(--mn);font-size:10px;color:var(--faint);margin-top:8px;letter-spacing:1px}
.mast-date .nw{white-space:nowrap}
{% if brand.masthead %}
/* Cabeçalho em bloco de cor (brand.masthead): logo, slogan, data e botões em on_masthead */
.mast-wrap.solid{--mh:{{ brand.masthead }};--on-mh:{{ brand.on_masthead }};--on-mh-rgb:{{ brand.rgb.on_masthead }};--fx-dot:var(--on-mh);--fx-line:var(--on-mh);background:var(--mh);background:linear-gradient(135deg,color-mix(in srgb,var(--mh) 94%,#fff),color-mix(in srgb,var(--mh) 92%,#000))}
:root[data-theme="dark"] .mast-wrap.solid{border-bottom-color:var(--qn);background:color-mix(in srgb,var(--mh) 82%,#000)}
.mast-wrap.solid #mast-canvas{opacity:.1}
.mast-wrap.solid .mast h1,.mast-wrap.solid .mast h1.logo svg{color:var(--on-mh)}
.mast-wrap.solid .mast-sub{color:rgba(var(--on-mh-rgb),.8)}
.mast-wrap.solid .mast-date{color:rgba(var(--on-mh-rgb),.72)}
.mast-wrap.solid .tool{background:transparent;border-color:rgba(var(--on-mh-rgb),.4);color:var(--on-mh)}
.mast-wrap.solid .tool:hover{border-color:var(--on-mh);background:rgba(var(--on-mh-rgb),.1)}
.mast-wrap.solid :focus-visible{outline-color:var(--on-mh)}
{% endif %}
.mast-tools{position:absolute;top:14px;right:16px;z-index:3;display:flex;gap:6px}
.tool{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border:1.5px solid var(--rule);border-radius:20px;background:var(--paper);font-family:var(--mn);font-size:9.5px;letter-spacing:1px;text-transform:uppercase;color:var(--mute2);cursor:pointer;transition:border-color .25s,color .25s}
.tool:hover{border-color:var(--link);color:var(--link)}
.tool svg{width:13px;height:13px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.tool .i-sun{display:none}
:root[data-theme="dark"] .tool .i-sun{display:block}
:root[data-theme="dark"] .tool .i-moon{display:none}

/* Ticker de cotações */
.tk{position:relative;background:var(--qn);font-family:var(--mn);font-size:10.5px;color:rgba(255,255,255,.62);overflow:hidden}
:root[data-theme="dark"] .tk{background:#0a1430}
.tk-track{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;row-gap:3px;padding:8px 20px}
.tk-i{white-space:nowrap}
.tk-i+.tk-i::before,.tk.run .tk-i::before{content:"·";color:rgba(255,255,255,.3);margin:0 10px}
.tk-i b{color:#fff;font-weight:500;margin-left:2px}
.tk .u{color:var(--up)}
.tk .d{color:var(--down)}
.tk .f{color:rgba(255,255,255,.62)}
.tk.run .tk-rail{display:flex;width:max-content;animation:tk-scroll var(--tk-dur,60s) linear infinite}
.tk.run .tk-track{flex-wrap:nowrap;justify-content:flex-start;padding:8px 0}
.tk.run:hover .tk-rail,.tk.run:focus-within .tk-rail,.tk.paused .tk-rail{animation-play-state:paused}
@keyframes tk-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.tk-pause{position:absolute;top:0;right:0;bottom:0;width:44px;padding-left:12px;border:none;background:linear-gradient(90deg,rgba(var(--qn-rgb),0),var(--qn) 45%);color:rgba(255,255,255,.75);font-size:10px;letter-spacing:-1px;cursor:pointer}
.tk-pause:hover{color:#fff}
:root[data-theme="dark"] .tk-pause{background:linear-gradient(90deg,rgba(10,20,48,0),#0a1430 45%)}
.tk-pause[hidden]{display:none}

/* Faixa de clima */
.wx{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 28px;padding:6px 20px;background:var(--soft);font-family:var(--mn);font-size:10px;color:var(--mute2);border-bottom:1px solid var(--rl)}
.wx p{white-space:nowrap}
.wx strong{color:var(--ink);font-weight:600;margin:0 6px 0 4px}
.wx .sep{color:var(--rule);margin:0 6px}

/* Editorial do dia */
.op-bar{padding:18px var(--gut);background:linear-gradient(135deg,var(--op-a),var(--op-b));border-bottom:1px solid var(--rl);font-size:15px;font-style:italic;color:var(--body);line-height:1.7;text-align:center}
.op-bar p{max-width:880px;margin:0 auto}
.op-bar strong{color:var(--ink)}

/* Rótulo de seção (Em 1 minuto, Destaques…) */
.kicker{font-family:var(--ss);font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;color:var(--link);margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid var(--qi)}

/* Em 1 minuto */
.brief{padding:16px var(--gut) 18px;border-bottom:1px solid var(--rl)}
.brief ul{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 32px}
.brief li{position:relative;padding-left:16px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
.brief li::before{content:"";position:absolute;left:0;top:.5em;width:6px;height:6px;border-radius:1px;background:var(--qc)}
.brief strong{color:var(--ink)}

/* Área clicável: o link do título cobre o bloco inteiro */
.hit::after{content:"";position:absolute;inset:0;z-index:1}
.hit:focus-visible{outline:none}
.hero-l,.ss,.cl,.dst li{position:relative}
.hero-l:has(.hit:focus-visible),.ss:has(.hit:focus-visible),.cl:has(.hit:focus-visible),.dst li:has(.hit:focus-visible){outline:2px solid var(--link);outline-offset:-3px}
.cat{font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:5px;color:var(--sc,var(--qi))}
:root[data-theme="dark"] .cat,:root[data-theme="dark"] .mcat{color:#9fb3d9;color:color-mix(in srgb,var(--sc,var(--qi)) 50%,#fff)}
.meta{font-family:var(--mn);font-size:9px;color:var(--faint);margin-top:8px;text-transform:uppercase;letter-spacing:.5px;line-height:1.5}
.meta>*+*::before{content:"·";margin:0 6px}
figure[data-img]{overflow:hidden;border-radius:3px;background:var(--soft)}
figure[data-img] img{width:100%;height:100%;object-fit:cover}
figure.img-fail{display:none}
:root[data-theme="dark"] figure[data-img] img{filter:brightness(.9)}

/* Manchete + chamadas */
.hero{display:grid;grid-template-columns:5fr 3fr;border-bottom:2px solid var(--qn)}
.hero.solo{grid-template-columns:1fr}
.hero-l{padding:26px var(--gut);border-right:1px solid var(--rule);cursor:pointer;transition:background .3s}
.hero.solo .hero-l{border-right:none}
.hero-l:hover{background:var(--hover)}
.hero-l h2{font-size:clamp(22px,3.2vw,34px);font-weight:900;line-height:1.12;margin-bottom:14px;letter-spacing:-.5px;color:var(--head)}
.hero-l .dek{font-family:var(--ss);font-size:15px;color:var(--body);line-height:1.6;margin-bottom:16px}
.hero-l .hi{height:260px;margin-bottom:16px}
.hero-l .sub{font-family:var(--ss);font-size:13.5px;color:var(--body);line-height:1.65;margin-bottom:10px}
.hero-l .sub strong{color:var(--ink)}
.hero-l .more{display:none}
.hero-l:not(:has(.hi)) .more,.hero-l:has(.hi.img-fail) .more{display:block}
.hero-l .rd{font-family:var(--ss);font-size:10px;color:var(--link);font-weight:700;letter-spacing:.5px;margin-top:12px}
.hero-r{display:flex;flex-direction:column}
.hero-r .ss{flex:1;padding:18px 22px;border-bottom:1px solid var(--rule);cursor:pointer;transition:background .3s;display:flex;flex-direction:column;justify-content:center}
.hero-r .ss:last-child{border-bottom:none}
.hero-r .ss:hover{background:var(--hover)}
.hero-r .ss h3{font-size:16px;font-weight:700;line-height:1.24;margin-bottom:6px;color:var(--ink)}
.hero-r .ss>p:not(.cat):not(.meta){font-family:var(--ss);font-size:12px;color:var(--muted);line-height:1.5}

/* Destaques numerados */
.dst{padding:14px var(--gut) 16px;background:linear-gradient(135deg,var(--soft),var(--paper));border-bottom:1px solid var(--rl)}
.dst ol{list-style:none;counter-reset:t;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
.dst li{counter-increment:t;display:flex;gap:10px;padding:9px 12px 9px 0;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:13px;line-height:1.4;border-radius:3px;cursor:pointer;transition:background .2s}
.dst li:hover{background:var(--hl)}
.dst li::before{content:counter(t);font-family:var(--sf);font-size:22px;font-weight:900;color:var(--link);min-width:20px;line-height:1}
.dst li:nth-child(odd){border-right:1px solid var(--rl)}
.dst li:nth-child(even){padding-left:12px}
.dst li:last-child:nth-child(odd){grid-column:1/-1;border-right:none}
.dst li>div{min-width:0}
.dst .dst-cat{display:block;margin-top:3px;font-family:var(--mn);font-size:8.5px;text-transform:uppercase;letter-spacing:1px;color:var(--faint)}

/* Busca */
.srch{display:flex;align-items:center;gap:12px;padding:10px var(--gut);background:var(--paper);border-top:2px solid var(--qn)}
.srch-label{font-family:var(--mn);font-size:9.5px;letter-spacing:1px;color:var(--faint);text-transform:uppercase;flex-shrink:0}
.srch-input{flex:1;min-width:0;max-width:420px;height:34px;padding:0 16px;border:1.5px solid var(--rl);border-radius:20px;font-family:var(--ss);font-size:13px;color:var(--ink);background:var(--bg);outline:none;transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;appearance:none}
.srch-input:focus{border-color:var(--qi);box-shadow:0 0 0 3px rgba(var(--qi-rgb),.15)}
.srch-input::placeholder{color:var(--faint)}
.srch-count{margin-left:auto;font-family:var(--mn);font-size:9.5px;color:var(--link);flex-shrink:0}
.no-res{padding:40px 22px;text-align:center;font-family:var(--ss);font-size:14px;color:var(--muted)}
.no-res[hidden]{display:none}

/* Abas por seção */
.tabs-bar{display:flex;overflow-x:auto;background:var(--soft);border-top:1px solid var(--rl);border-bottom:2px solid var(--rl);scrollbar-width:none;-webkit-overflow-scrolling:touch}
.tabs-bar::-webkit-scrollbar{display:none}
.tab-btn{flex-shrink:0;margin-bottom:-2px;padding:12px 18px;border:none;border-bottom:3px solid var(--sc,var(--qi));background:transparent;font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;white-space:nowrap;color:var(--mute2);cursor:pointer;transition:background .25s,color .25s}
.tab-btn:hover{color:var(--ink);background:var(--paper)}
.tab-btn[aria-selected="true"]{color:var(--ink);background:var(--paper)}
.tab-btn .n{margin-left:4px;font-family:var(--mn);font-size:9px;font-weight:500;letter-spacing:0;color:var(--faint)}
.tab-btn:focus-visible{outline-offset:-3px}
@media (min-width:900px){.tab-btn{padding:12px 11px;letter-spacing:.8px}.tabs-bar{flex-wrap:wrap}}
.tabs-wrap.searching .tab-btn[aria-selected="true"]{color:var(--mute2);background:transparent}
.tabs-nav{position:relative}
.tabs-arrow{position:absolute;top:0;bottom:2px;z-index:2;width:40px;border:none;font-family:var(--ss);font-size:22px;line-height:1;color:var(--ink);cursor:pointer}
.tabs-arrow.prev{left:0;padding-right:12px;background:linear-gradient(90deg,var(--soft) 55%,transparent)}
.tabs-arrow.next{right:0;padding-left:12px;background:linear-gradient(270deg,var(--soft) 55%,transparent)}
.tabs-arrow:hover{color:var(--link)}
.tabs-arrow[hidden]{display:none}
:root[data-theme="dark"] .tab-btn{border-bottom-color:color-mix(in srgb,var(--sc,var(--qi)) 60%,#fff)}
.tab-layout{display:flex;align-items:stretch}
.tab-main{flex:7;min-width:0;border-right:1px solid var(--rl)}
.tab-side{flex:3;min-width:0;position:relative;min-height:460px;background:var(--side)}
.pane-hd{display:none;padding:16px 22px 8px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--sc,var(--qi));border-bottom:2px solid var(--sc,var(--qi))}
:root[data-theme="dark"] .pane-hd{color:color-mix(in srgb,var(--sc,var(--qi)) 50%,#fff)}
.js .tab-pane{display:none}
.js .tab-pane.active,.js .tabs-wrap.searching .tab-pane{display:block}
.js .tabs-wrap.searching .tab-pane.empty{display:none}
.tabs-wrap.all .pane-hd,.tabs-wrap.searching .pane-hd,html:not(.js) .pane-hd{display:block}
html:not(.js) .tabs-bar{display:none}
.tabs-wrap.searching .cl.is-hidden{display:none}

/* Cards */
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden;padding-bottom:1px}
.cl{padding:18px 22px;background:var(--paper);box-shadow:1px 0 0 var(--rl),0 1px 0 var(--rl);cursor:pointer;transition:background .35s cubic-bezier(.23,1,.32,1),transform .35s cubic-bezier(.23,1,.32,1),box-shadow .35s cubic-bezier(.23,1,.32,1)}
.tabs-wrap:not(.searching) .cl:last-child:nth-child(odd){grid-column:1/-1}
.cl:hover{background:var(--hover);transform:translateY(-2px);box-shadow:1px 0 0 var(--rl),0 1px 0 var(--rl),0 8px 30px rgba(var(--qi-rgb),.08);z-index:5}
:root[data-theme="dark"] .cl:hover{box-shadow:1px 0 0 var(--rl),0 1px 0 var(--rl),0 8px 30px rgba(0,0,0,.3)}
.cl .ci{height:140px;margin-bottom:10px}
.tabs-wrap:not(.searching) .cl:last-child:nth-child(odd) .ci{height:200px}
.cl h3{font-size:16px;font-weight:700;line-height:1.24;margin-bottom:8px;color:var(--ink)}
.cl .dk{font-family:var(--ss);font-size:12.5px;color:var(--muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}

/* Radar (coluna lateral) */
/* O radar acompanha a altura da coluna principal e rola por dentro quando não cabe. */
.radar{position:absolute;inset:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;padding:24px 20px}
.radar-hd{display:flex;align-items:center;gap:8px;margin-bottom:18px;padding-bottom:8px;border-bottom:2px solid var(--qn);font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
:root[data-theme="dark"] .radar-hd{border-bottom-color:var(--qi)}
.radar-hd::before{content:"";width:6px;height:6px;flex-shrink:0;border-radius:50%;background:var(--qr);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(var(--qr-rgb),.4)}70%{box-shadow:0 0 0 5px rgba(var(--qr-rgb),0)}100%{box-shadow:0 0 0 0 rgba(var(--qr-rgb),0)}}
.radar-list{list-style:none;display:flex;flex-direction:column;gap:14px}
.radar-list li{padding-bottom:14px;border-bottom:1px dashed var(--rl)}
.radar-list li:last-child{padding-bottom:0;border-bottom:none}
.radar-item{display:block;transition:opacity .2s}
.radar-item:hover{opacity:.65}
.radar-item .tm{font-family:var(--mn);font-size:9.5px;font-weight:600;color:var(--link)}
.radar-item .src{margin-left:6px;font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;color:var(--mute2)}
.radar-item .tt{display:block;margin-top:5px;font-family:var(--sf);font-size:13.5px;font-weight:600;line-height:1.35;color:var(--ink)}

/* Modal da matéria */
body.modal-open{overflow:hidden}
.mo{display:none;position:fixed;inset:0;z-index:1000;overflow-y:auto;overscroll-behavior:contain;padding:40px 20px;background:rgba(var(--qn-rgb),.5);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
:root[data-theme="dark"] .mo{background:rgba(0,0,0,.6)}
.mo.on,html:not(.js) .mo:target{display:flex;justify-content:center;align-items:flex-start}
.ml{position:relative;width:100%;max-width:700px;padding:40px 44px;background:var(--paper);border-top:4px solid var(--sc,var(--qi));box-shadow:0 20px 60px rgba(var(--qn-rgb),.2);animation:ml-in .35s cubic-bezier(.2,.9,.3,1.15)}
:root[data-theme="dark"] .ml{background:#161f31}
.ml:focus{outline:none}
@keyframes ml-in{from{opacity:0;transform:translateY(28px) scale(.97)}to{opacity:1;transform:none}}
/* O × acompanha a rolagem do modal (.mo é o contêiner que rola): matéria longa aberta pelo e-mail não o esconde. */
.mc{position:sticky;top:8px;float:right;z-index:2;margin:-28px -30px 0 0;width:36px;height:36px;border:none;border-radius:50%;background:var(--paper);font-family:var(--ss);font-size:26px;line-height:1;color:var(--faint);cursor:pointer;transition:color .2s,background .2s}
:root[data-theme="dark"] .mc{background:#161f31}
.mback{margin-top:22px;text-align:center}
.mc2{padding:9px 18px;border:1.5px solid var(--rl);border-radius:20px;background:transparent;font-family:var(--ss);font-size:12px;font-weight:700;letter-spacing:.5px;color:var(--link);cursor:pointer}
.mc2:hover{border-color:var(--link)}
.mc:hover{color:var(--ink);background:var(--soft)}
.ml .mcat{font-family:var(--ss);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;margin-bottom:8px;color:var(--sc,var(--qi))}
.ml h2{padding-right:24px;font-size:26px;font-weight:900;line-height:1.2;margin-bottom:12px;color:var(--head)}
.ml .mdek{font-family:var(--ss);font-size:15px;line-height:1.6;color:var(--body)}
.ml .mhd{padding-bottom:14px;margin-bottom:20px;border-bottom:2px solid var(--qi)}
.ml .mi{margin-bottom:20px;max-height:380px}
.ml .bt p{font-family:var(--ss);font-size:15px;line-height:1.8;color:var(--text)}
.ml .bt p+p{margin-top:14px}
.ml .bt strong{color:var(--ink)}
.ml .why{margin-top:22px;padding:14px 18px;background:var(--soft);border-left:3px solid var(--qc)}
.ml .why h3,.ml .bb h3{font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint);margin-bottom:6px}
.ml .why p{font-family:var(--sf);font-size:15px;font-style:italic;line-height:1.6;color:var(--ink)}
.ml .bb{margin-top:24px;padding-top:14px;border-top:1px solid var(--rl)}
.ml .bb ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px 18px}
.ml .bb a,.ml .bb span{font-family:var(--mn);font-size:11.5px;color:var(--link)}
.ml .bb span{color:var(--muted)}
.ml .bb a:hover{color:var(--qr);text-decoration:underline}
.ml .mtime{margin-top:16px;font-family:var(--mn);font-size:10px;color:var(--faint);letter-spacing:.5px}

/* Cobertura comparada: lado A à esquerda, neutros no meio, lado B à direita */
:root{--cov-a:var(--qi);--cov-b:#C8631A;--cov-n:#C5CCD8}
:root[data-theme="dark"]{--cov-a:#8FA0CC;--cov-a:color-mix(in srgb,var(--qi) 55%,#fff);--cov-b:#FF8A5C;--cov-n:#3A4658}
.cov-bar{display:flex;gap:2px;height:8px;border-radius:4px;overflow:hidden;background:var(--rl)}
.cov-bar span{display:block;height:100%;min-width:4px}
.cov-a{background:var(--cov-a)}
.cov-n{background:var(--cov-n)}
.cov-b{background:var(--cov-b)}
.cov.mini{margin-top:10px}
.cov.mini .cov-bar{height:5px}
.cov-lean{margin-top:5px;font-family:var(--mn);font-size:9px;letter-spacing:.3px;line-height:1.45;color:var(--mute2)}
.cov-lean::before,.cov-sa::before,.cov-sb::after{content:"";display:inline-block;width:7px;height:7px;border-radius:2px;background:var(--cov-n)}
.cov-lean::before{margin-right:6px}
.lean-a .cov-lean::before,.cov-sa::before{background:var(--cov-a)}
.lean-b .cov-lean::before,.cov-sb::after{background:var(--cov-b)}
.lean-equilibrio .cov-lean::before{background:linear-gradient(90deg,var(--cov-a) 50%,var(--cov-b) 50%)}
.cov.full .cov-lean{font-size:10px;font-weight:600;color:var(--ink)}
.cov-scale{display:flex;justify-content:space-between;gap:16px;margin-bottom:6px;font-family:var(--ss);font-size:11.5px;font-weight:600;line-height:1.35;color:var(--ink)}
.cov-sa::before{margin-right:6px}
.cov-sb{text-align:right}
.cov-sb::after{margin-left:6px}
.cov-scale b{font-family:var(--mn);font-weight:600;color:var(--mute2)}
.cov-c{margin-top:8px;font-family:var(--sf);font-size:14.5px;font-style:italic;line-height:1.55;color:var(--ink)}
.cov-who{margin-top:10px}
.cov-who summary{cursor:pointer;font-family:var(--ss);font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--link)}
.cov-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 20px;margin-top:10px}
.cov-col.cn:only-child,.cov-col.cn:nth-child(3){grid-column:1/-1}
.cov-col h4{margin-bottom:6px;padding-bottom:4px;border-bottom:2px solid var(--cov-n);font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--mute2)}
.cov-col.ca h4{border-bottom-color:var(--cov-a)}
.cov-col.cb h4{border-bottom-color:var(--cov-b)}
.cov-col h4 span{font-family:var(--mn);font-weight:500}
.cov-col ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.cov-col li{font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body)}
.cov-col a,.cov-col b{font-weight:700;color:var(--ink)}
.cov-col a:hover{color:var(--link);text-decoration:underline}
.cov-col li p.cov-f{margin-top:2px;color:var(--muted)}
.mcomp{margin-bottom:8px;font-family:var(--ss);font-size:12px;color:var(--muted)}
.ml .mcov{margin-top:22px;padding:16px 18px;border:1px solid var(--rl);border-radius:4px;background:var(--soft)}
.ml .mcov>h3{margin-bottom:10px;font-family:var(--mn);font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--faint)}
.cmp{padding:22px var(--gut) 30px;border-top:2px solid var(--qn);background:var(--paper)}
:root[data-theme="dark"] .cmp{border-top-color:var(--qi)}
.cmp-note{max-width:860px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.cmp-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px;margin-top:6px}
.cmp-i{padding:16px 0;border-bottom:1px solid var(--rl)}
.cmp-i h3{margin-bottom:8px;font-size:17px;font-weight:700;line-height:1.3;color:var(--ink)}
.cmp-i h3 a:hover{color:var(--link);text-decoration:underline}
.cmp-t{font-weight:500;letter-spacing:.5px;color:var(--faint)}

/* Racional da edição e lista completa do dia */
.rat-strip{padding:9px var(--gut);border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--muted)}
.rat-strip span{color:var(--ink);font-weight:600}
.rat-strip a{color:var(--link);font-weight:700;white-space:nowrap}
.rat-strip a:hover{text-decoration:underline}
.rat{padding:22px var(--gut) 26px;border-top:2px solid var(--qn);background:var(--paper)}
:root[data-theme="dark"] .rat{border-top-color:var(--qi)}
.rat-sum{max-width:900px;font-family:var(--sf);font-size:16px;line-height:1.6;color:var(--ink)}
.rat-blocks{list-style:none;counter-reset:blk;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px 24px;margin-top:14px}
.rat-blocks li{counter-increment:blk;display:flex;flex-direction:column;gap:2px;padding:10px 12px;border-left:3px solid var(--qi);background:var(--soft);font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--muted)}
.rat-blocks li.off{border-left-color:var(--cov-n)}
.rat-blocks b{color:var(--ink)}
.rat-blocks b::before{content:counter(blk) ". ";font-family:var(--mn);font-weight:500;color:var(--faint)}
.rat-note{max-width:900px;margin-top:14px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.todas{padding:22px var(--gut) 30px;border-top:2px solid var(--qn);background:var(--paper)}
:root[data-theme="dark"] .todas{border-top-color:var(--qi)}
.todas .kicker span{font-family:var(--mn);font-weight:500;letter-spacing:.5px;color:var(--faint)}
.todas-note{max-width:900px;margin-bottom:10px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.todas-sec{border-top:1px solid var(--rl)}
.todas-sec:last-child{border-bottom:1px solid var(--rl)}
.todas-sec>summary{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;padding:11px 0;cursor:pointer;font-family:var(--ss);font-size:14px;color:var(--ink)}
.todas-sec>summary b{padding-left:9px;border-left:3px solid var(--sc)}
.todas-sec>summary span{font-size:12px;color:var(--muted)}
.idx{list-style:none;display:flex;flex-direction:column;gap:10px;padding:2px 0 16px 12px}
.idx-h{font-family:var(--ss);font-size:13.5px;font-weight:700;line-height:1.4;color:var(--ink)}
.idx-h a{color:var(--link)}
.idx-h a:hover{text-decoration:underline}
.idx-h em{margin-left:4px;padding:1px 6px;border-radius:3px;background:var(--soft);font-family:var(--mn);font-size:9.5px;font-style:normal;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--link)}
.idx-h em.cmpd{color:var(--mute2)}
.idx-h span{font-weight:500;color:var(--faint)}
.idx-t ul{list-style:none;display:flex;flex-direction:column;gap:3px;margin-top:3px;padding-left:10px;border-left:1px solid var(--rl)}
.idx-t li{font-family:var(--ss);font-size:12.5px;line-height:1.45;color:var(--body)}
.idx-t li b{font-weight:600;color:var(--mute2)}
.idx-t li a{color:var(--body)}
.idx-t li a:hover{color:var(--link);text-decoration:underline}
.idx-t time{font-family:var(--mn);font-size:10.5px;color:var(--faint)}
.rat-all{margin-top:14px;font-family:var(--ss);font-size:13px;font-weight:700}
.rat-all a{color:var(--link)}
.rat-all a:hover{text-decoration:underline}

/* Rodapé */
.ft{background:var(--qn);padding:20px 28px;text-align:center;font-family:var(--mn);font-size:9.5px;letter-spacing:1.5px;line-height:1.8;color:rgba(255,255,255,.62);text-transform:uppercase}
:root[data-theme="dark"] .ft{background:#0a1430}
.ft strong{color:var(--qc)}
.ft a{color:#fff;border-bottom:1px solid rgba(255,255,255,.3);transition:border-color .2s}
.ft a:hover{border-bottom-color:var(--qc)}
.ft-links{margin-top:6px}
.ft details{max-width:960px;margin:14px auto 0;text-align:left}
.ft summary{cursor:pointer;text-align:center;color:rgba(255,255,255,.8)}
.ft summary:hover{color:#fff}
.src-list{list-style:none;margin-top:12px;columns:3 220px;column-gap:28px;text-transform:none;letter-spacing:.2px;font-size:10.5px}
.src-list li{break-inside:avoid;padding:2px 0 2px 14px;position:relative}
.src-list .dot{position:absolute;left:0;top:.55em;width:7px;height:7px;border-radius:50%;background:var(--qc)}
.src-list .st-parcial .dot{background:#F5B83D}
.src-list .st-erro .dot{background:var(--qr)}
.src-list .nf{color:rgba(255,255,255,.45)}
.src-list em{font-style:normal;color:#ffb3cf}

/* Voltar ao topo */
.btt{position:fixed;right:24px;bottom:24px;z-index:998;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border:none;border-radius:50%;background:var(--qi);color:#fff;cursor:pointer;box-shadow:0 4px 18px rgba(var(--qi-rgb),.4);opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .3s,transform .3s,visibility .3s,background .3s}
.btt.show{opacity:1;visibility:visible;transform:none}
.btt:hover{background:var(--qn)}
.btt svg{width:18px;height:18px;fill:currentColor}
body.modal-open .btt{visibility:hidden}

/* Arquivo de edições */
.arch{padding:24px var(--gut) 36px;min-height:40vh}
.arch-top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap}
.arch-top .kicker{flex:1}
.arch-home{font-family:var(--ss);font-size:12px;font-weight:700;color:var(--link)}
.arch-home:hover{text-decoration:underline}
.arch-m{margin:22px 0 4px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
.arch-list{list-style:none}
.arch-list li{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--rl)}
.arch-list a{flex:1;display:flex;gap:18px;align-items:baseline;padding:11px 8px 11px 0;min-width:0;transition:background .2s}
.arch-list a:hover{background:var(--hover)}
.arch-list time{flex:0 0 250px;font-family:var(--mn);font-size:11px;color:var(--mute2)}
.arch-t{font-size:15px;font-weight:700;line-height:1.3;color:var(--ink)}
.badge{flex-shrink:0;padding:1px 6px;border:1px solid var(--rule);border-radius:10px;font-family:var(--mn);font-size:8.5px;letter-spacing:1px;color:var(--faint)}
.arch-empty{padding:30px 0;font-family:var(--ss);color:var(--muted)}
{% if brand.termometro %}
/* Termômetro de Viés Editorial (fim da edição) e aba Analítico Político.
   Escala divergente validada (rampa ordinal por braço, claro e escuro):
   verde-azulado = esquerda, âmbar = direita, cinza = equilíbrio; misto hachurado. */
:root{--t-ef:#0B5F6B;--t-em:#2E8F9C;--t-el:#7FBCC4;--t-eq:#AEB6C2;--t-dl:#E2A66E;--t-dm:#C77A2E;--t-df:#8F4A0E;--t-na:#D0D5DD}
:root[data-theme="dark"]{--t-ef:#86D3DC;--t-em:#46A9B6;--t-el:#327E88;--t-eq:#4A576B;--t-dl:#9A6536;--t-dm:#CF8A45;--t-df:#F2B577;--t-na:#2D3748}
.t-ef{background:var(--t-ef)}.t-em{background:var(--t-em)}.t-el{background:var(--t-el)}.t-eq{background:var(--t-eq)}
.t-dl{background:var(--t-dl)}.t-dm{background:var(--t-dm)}.t-df{background:var(--t-df)}.t-na{background:var(--t-na)}
.t-mx{background:repeating-linear-gradient(135deg,var(--t-eq) 0 3px,transparent 3px 6px);box-shadow:inset 0 0 0 1px var(--t-eq)}
.sw{display:inline-block;width:8px;height:8px;margin-right:6px;border-radius:2px;vertical-align:baseline}
.term{padding:22px var(--gut) 26px;border-top:2px solid var(--qn);background:var(--paper)}
:root[data-theme="dark"] .term{border-top-color:var(--qi)}
.term-sum{max-width:900px;font-family:var(--sf);font-size:17px;font-weight:600;line-height:1.5;color:var(--ink)}
.term-sum span{font-family:var(--mn);font-size:10.5px;font-weight:500;letter-spacing:.3px;color:var(--mute2)}
.term-meta{max-width:900px;margin-top:12px;font-family:var(--mn);font-size:10px;letter-spacing:.3px;line-height:1.6;color:var(--mute2)}
.term-note{max-width:900px;margin-top:12px;font-family:var(--ss);font-size:12.5px;line-height:1.55;color:var(--muted)}
.term-det{margin-top:14px}
.term-det>summary{cursor:pointer;font-family:var(--ss);font-size:12px;font-weight:700;letter-spacing:.3px;color:var(--link)}
.term-det>summary:hover{text-decoration:underline}
.tg{max-width:900px;margin-top:14px}
.tg-track{position:relative;height:14px}
.tg-bands{position:absolute;inset:0;overflow:hidden;border-radius:7px;background:var(--rl)}
.tg-f{position:absolute;top:0;bottom:0;opacity:.38;border-right:2px solid var(--paper)}
.tg-f:last-child{border-right:none}
.tg-zero{position:absolute;left:50%;top:-4px;bottom:-4px;width:2px;margin-left:-1px;background:var(--rule)}
.tg-ic{position:absolute;top:3px;bottom:3px;border-radius:4px;background:var(--ink);opacity:.28}
.tg-dot{position:absolute;top:50%;width:16px;height:16px;margin:-8px 0 0 -8px;border:2px solid var(--paper);border-radius:50%;background:var(--ink);box-shadow:0 0 0 1px var(--ink)}
.tg-axis{display:flex;justify-content:space-between;margin-top:6px;font-family:var(--mn);font-size:9px;letter-spacing:.4px;text-transform:uppercase;color:var(--faint)}
.td{max-width:900px;margin-top:16px}
.td-bar{display:flex;gap:2px;height:10px;overflow:hidden;border-radius:5px;background:var(--rl)}
.td-bar span{display:block;height:100%;min-width:4px}
.td-leg{list-style:none;display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:7px;font-family:var(--ss);font-size:11.5px;color:var(--muted)}
.td-leg i{display:inline-block;width:9px;height:9px;margin-right:5px;border-radius:2px;vertical-align:-1px}
.td-leg b{font-family:var(--mn);font-weight:600;color:var(--ink)}
.ta-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 32px;margin-top:8px}
.ta{padding:14px 0;border-bottom:1px solid var(--rl)}
.ta-hd{display:flex;gap:12px;align-items:flex-start}
.ta-v{flex:0 0 auto;min-width:48px;padding:3px 0;font-family:var(--mn);font-size:15px;font-weight:600;color:var(--ink);white-space:nowrap}
.ta-tx{min-width:0}
.ta-src{font-family:var(--ss);font-size:11px;line-height:1.4;color:var(--muted)}
.ta-src b{color:var(--ink)}
.ta-t{margin-top:2px;font-size:15px;font-weight:700;line-height:1.35;color:var(--ink)}
.ta-t a:hover{color:var(--link);text-decoration:underline}
.ta-scale{position:relative;height:4px;margin:10px 0 2px;border-radius:2px;background:var(--rl)}
.ta-scale .tg-zero{top:-3px;bottom:-3px}
.ta-dot{position:absolute;top:50%;width:10px;height:10px;margin:-5px 0 0 -5px;border:2px solid var(--paper);border-radius:50%}
.ta-r{margin-top:8px;font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--muted)}
.ta-r b{color:var(--ink)}
.ta-sum{margin-top:4px;font-family:var(--sf);font-size:13.5px;line-height:1.5;color:var(--body)}
.ta-ev{margin-top:6px}
.ta-ev summary{cursor:pointer;font-family:var(--ss);font-size:11px;font-weight:700;color:var(--link)}
.ta-ev ol{margin:8px 0 0 18px;display:flex;flex-direction:column;gap:8px;font-family:var(--ss);font-size:12px;line-height:1.45;color:var(--body)}
.ta-ev b{color:var(--ink)}
.ta-dir{margin-left:6px;font-family:var(--mn);font-size:10px;color:var(--mute2)}
.ta-ev q{display:block;margin-top:2px;font-family:var(--sf);font-style:italic;color:var(--ink)}
.ta-ex{display:block;margin-top:2px;color:var(--muted)}
.tl-list{list-style:none;margin-top:8px}
.tl{display:grid;grid-template-columns:56px 44px minmax(0,1fr) auto;gap:10px;align-items:baseline;padding:7px 0;border-bottom:1px solid var(--rl);font-family:var(--ss);font-size:12.5px;line-height:1.4;color:var(--body)}
.tl .ta-v{min-width:0;padding:0;font-size:12.5px}
.tl-d{font-family:var(--mn);font-size:10.5px;color:var(--faint)}
.tl-tx b{color:var(--ink)}
.tl-tx a{color:var(--ink)}
.tl-tx a:hover{color:var(--link);text-decoration:underline}
.tl-r{font-size:11.5px;color:var(--muted);white-space:nowrap}
.an{padding:24px var(--gut) 36px}
.an-intro{max-width:900px;font-family:var(--sf);font-size:16px;line-height:1.6;color:var(--ink)}
.an-blk{margin-top:26px;padding-top:16px;border-top:1px solid var(--rl)}
.an-h{margin-bottom:10px;font-family:var(--ss);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:var(--head)}
.an-tiles{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}
.an-tiles li,.an-reads li{display:flex;flex-direction:column;gap:3px;padding:12px 14px;border-left:3px solid var(--qi);background:var(--soft)}
.an-tl{font-family:var(--ss);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.an-tiles b{font-family:var(--mn);font-size:24px;font-weight:600;color:var(--ink)}
.an-td{font-family:var(--ss);font-size:11.5px;line-height:1.4;color:var(--muted)}
.an-reads{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.an-reads b{font-family:var(--ss);font-size:15px;font-weight:800;color:var(--ink)}
.an-reads p{font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--body)}
.an-reads .rd-esq{border-left-color:var(--t-em)}
.an-reads .rd-dir{border-left-color:var(--t-dm)}
.an-reads .rd-est,.an-reads .rd-melhor{border-left-color:var(--t-eq)}
.an-reads .rd-pior{border-left-color:var(--qr)}
.an-reads .rd-ins{border-left-color:var(--rule)}
.an-pux{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}
.an-tbl-wrap{overflow-x:auto}
.an-tbl{width:100%;border-collapse:collapse;font-family:var(--ss);font-size:12.5px;color:var(--body)}
.an-tbl caption{margin-bottom:6px;text-align:left;font-size:11px;font-weight:700;color:var(--muted)}
.an-tbl th,.an-tbl td{padding:7px 10px 7px 0;border-bottom:1px solid var(--rl);text-align:right;white-space:nowrap}
.an-tbl th:first-child,.an-tbl td.an-l{text-align:left}
.an-tbl thead th{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--muted)}
.an-tbl tbody th{font-weight:700;color:var(--ink)}
.an-tbl td{font-family:var(--mn);font-size:11.5px}
.an-tbl td.an-l{font-family:var(--ss);font-size:12px}
.an-tbl a{color:var(--link)}
.an-tbl a:hover{text-decoration:underline}
.ts{max-width:900px;margin:0 0 22px}
.ts figcaption{margin-bottom:8px;font-family:var(--ss);font-size:12px;font-weight:700;color:var(--ink)}
.ts-plot{position:relative;height:200px;margin-left:38px}
.ts-g{position:absolute;left:0;right:0;height:0;border-top:1px solid var(--rl)}
.ts-g i{position:absolute;right:100%;margin-right:8px;transform:translateY(-50%);font-family:var(--mn);font-size:9.5px;font-style:normal;color:var(--faint);white-space:nowrap}
.ts-z{border-top:2px solid var(--rule)}
.ts-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ts-band{fill:var(--qi);opacity:.14}
.ts-line{fill:none;stroke:var(--qi);stroke-width:2;stroke-linejoin:round}
:root[data-theme="dark"] .ts-band{fill:var(--link)}
:root[data-theme="dark"] .ts-line{stroke:var(--link)}
.ts-pt{position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;border:2px solid var(--paper);border-radius:50%;background:var(--qi);cursor:default}
:root[data-theme="dark"] .ts-pt{background:var(--link)}
.ts-pt::before{content:"";position:absolute;inset:-8px}
.ts-x{position:relative;height:16px;margin:6px 0 0 38px;font-family:var(--mn);font-size:9.5px;color:var(--faint)}
.ts-x span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.ts-x span:first-child{transform:none}
.ts-x span:last-child:not(:first-child){transform:translateX(-100%)}
.rk,.qb,.rk-axis{list-style:none;max-width:900px}
.rk-i,.qb li,.rk-axis{display:grid;grid-template-columns:180px minmax(0,1fr) 220px;gap:14px;align-items:center;padding:7px 0;border-bottom:1px solid var(--rl)}
.rk-axis{border-bottom:none;padding-top:4px}
.rk-n{font-family:var(--ss);font-size:12.5px;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rk-p{position:relative;height:14px}
.rk-axis .rk-p{height:12px}
.rk-axis i{position:absolute;transform:translateX(-50%);font-family:var(--mn);font-size:9px;font-style:normal;color:var(--faint);white-space:nowrap}
.rk-axis i:first-child{transform:none}
.rk-axis i:last-child{transform:translateX(-100%)}
.rk-z{position:absolute;top:-4px;bottom:-4px;width:2px;margin-left:-1px;background:var(--rule)}
.rk-ic{position:absolute;top:50%;height:2px;margin-top:-1px;background:var(--mute2)}
.rk-d{position:absolute;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px}
.rk-d i{display:block;width:100%;height:100%;border:2px solid var(--paper);border-radius:50%;box-shadow:0 0 0 1px var(--ink)}
.rk-v{font-family:var(--ss);font-size:12px;line-height:1.35;color:var(--muted)}
.rk-v b{font-family:var(--mn);font-size:13px;color:var(--ink)}
.rk-x{display:block;font-family:var(--mn);font-size:9.5px;color:var(--faint)}
.qb-bar{display:block;height:10px;border-radius:0 4px 4px 0;background:var(--rl)}
.qb-bar span{display:block;height:100%;border-radius:0 4px 4px 0;background:var(--qi)}
:root[data-theme="dark"] .qb-bar span{background:var(--link)}
@media (max-width:760px){
  .term,.an{padding:18px 16px 24px}
  .term-sum{font-size:15.5px}
  .ta-list,.an-reads,.an-pux{grid-template-columns:1fr}
  .tl{grid-template-columns:52px minmax(0,1fr);gap:2px 10px}
  .tl-tx{grid-column:2;grid-row:1}
  .tl-d{grid-column:1;grid-row:2}
  .tl-r{grid-column:2;grid-row:2;white-space:normal}
  .an-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}
  .rk-i,.qb li,.rk-axis{grid-template-columns:34% minmax(0,1fr);gap:4px 10px}
  .rk-v{grid-column:1/-1}
  .rk-axis .rk-v{display:none}
}
@media (max-width:400px){
  .tool.tool-an span{display:none}
}
{% endif %}

/* ── Computador (a partir de 1024 px): primeira página no desenho de jornal ──
   Cabeçalho compacto (data e hora da edição à esquerda, logo ao centro, ferramentas
   à direita), barra de editorias com régua dupla e uma grade 2/3 + 1/3: na coluna
   principal, o editorial, a manchete (texto à esquerda, foto à direita, chamada
   relacionada abaixo do texto), "Mais para ler" numerado em duas colunas com
   miniatura e "Em 1 minuto"; no trilho, as chamadas com foto e o Radar, que
   acompanha a altura da coluna principal, rola por dentro e diz quantos itens faltam.
   Abaixo disso, as abas (cards com réguas finas), o racional e a cobertura comparada.
   Abaixo de 1024 px nada disto aparece e valem os blocos originais (op-bar, brief,
   hero, dst), ocultos no computador. */
.mast-l,.sec-nav,.fp{display:none}
@media (min-width:1024px){
  :root{--gut:32px;--fr:var(--ink)}
  :root[data-theme="dark"]{--fr:#75829a}

  /* Cabeçalho */
  .mast{padding:16px 300px 14px}
  .mast h1.logo svg,.mast h1.logo.mono svg{height:clamp(64px,4.2vw,92px)}
  .mast h1.logo+.mast-sub{margin-top:8px}
  .mast-sub{font-size:9px}
  .mast-l:not(:empty){display:block;position:absolute;z-index:3;left:var(--gut);top:50%;transform:translateY(-50%);font-family:var(--ss);text-align:left}
  .mast-l:not(:empty)~.mast .mast-date{display:none}
  .mast-l .ml-d{font-size:13px;font-weight:600;line-height:1.4;color:var(--on-mh,var(--head))}
  .mast-l .ml-e{margin-top:3px;font-family:var(--mn);font-size:10px;letter-spacing:.6px;color:var(--faint)}
  .mast-wrap.solid .mast-l .ml-e{color:rgba(var(--on-mh-rgb),.72)}
  .mast-l .nw{white-space:nowrap}
  .mast-tools{top:50%;right:var(--gut);transform:translateY(-50%)}

  /* Barra de editorias (leva às abas) com régua dupla; os atalhos da edição ficam
     à direita e, se não couberem na mesma linha das editorias, descem juntos para
     uma segunda linha, alinhados à direita */
  .sec-nav{display:block;padding:0 var(--gut);background:var(--paper)}
  .sn-in{display:flex;flex-wrap:wrap;align-items:center;gap:4px 24px;padding:10px 0 9px;border-bottom:4px double var(--fr)}
  .sec-nav ul{list-style:none;display:flex;flex-wrap:wrap;align-items:center;gap:2px 14px}
  .sn-ed{flex:1 1 auto;min-width:0}
  .sn-x{flex:none;margin-left:auto;padding-left:14px;border-left:1px solid var(--rule)}
  :root[data-theme="dark"] .sn-x{border-left-color:var(--fr)}
  .sec-nav a{display:block;padding:3px 0 2px;font-family:var(--ss);font-size:13px;font-weight:500;color:var(--ink);white-space:nowrap;box-shadow:inset 0 -2px 0 transparent;transition:color .2s,box-shadow .2s}
  .sec-nav a:hover{color:var(--link);box-shadow:inset 0 -2px 0 var(--sc,var(--qi))}
  .sn-x a{color:var(--mute2)}
  .sn-x a:hover{color:var(--link)}

  /* Grade da primeira página */
  .fp{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);padding:20px var(--gut) 0;background:var(--paper)}
  .fp~.op-bar,.fp~.brief,.fp~.rat-strip,.fp~.hero,.fp~.dst{display:none}
  .fp-main{min-width:0;padding-right:24px}
  .fp-rail{display:flex;flex-direction:column;min-width:0;padding-left:24px;border-left:1px solid var(--rl)}
  .fp .cat{margin-bottom:6px}
  .fp-lead,.fp-rel,.fp-mi,.fp-r1,.fp-r2i{position:relative;cursor:pointer}
  .fp-lead:has(>.fp-lt>h2 .hit:focus-visible),.fp-rel:has(.hit:focus-visible),.fp-mi:has(.hit:focus-visible),.fp-r1:has(.hit:focus-visible),.fp-r2i:has(.hit:focus-visible){outline:2px solid var(--link);outline-offset:3px}
  .fp h2 a,.fp h3 a{transition:color .2s}
  .fp-lead:not(:has(.fp-rel:hover)):hover h2 a,.fp-rel:hover h3 a,.fp-mi:hover h3 a,.fp-r1:hover h3 a,.fp-r2i:hover h3 a,.fp-op a:hover .fp-tt{color:var(--link)}
  .fp-lbl{display:flex;align-items:center;gap:8px;padding:9px 0 3px;font-family:var(--ss);font-size:10.5px;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:var(--head)}
  .fp-n{font-family:var(--mn);font-size:10px;font-weight:500;letter-spacing:0;color:var(--faint)}

  /* Caixa principal: editorial, manchete e "Mais para ler" */
  .fp-box{padding:0 18px 4px;border:1px solid var(--fr)}
  .fp-ed{padding:16px 5% 0;text-align:center}
  .fp-ed-k{font-family:var(--ss);font-size:9.5px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--link)}
  .fp-ed-t{max-width:860px;margin:6px auto 0;font-family:var(--sf);font-size:14.5px;font-style:italic;line-height:1.6;color:var(--body)}
  .fp-ed-t strong{color:var(--ink)}
  .fp-ed::after{content:"";display:block;width:64px;height:2px;margin:12px auto 0;background:var(--qi)}
  /* Coluna de texto em 40% (padrão), 45% (wm) ou metade (wt) do pacote */
  .fp-lead{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr);gap:0 20px;padding:20px 0}
  .fp-lead.wm{grid-template-columns:minmax(0,9fr) minmax(0,11fr)}
  .fp-lead.wt{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .fp-lead.noimg,.fp-lead:has(.fp-li.img-fail){grid-template-columns:1fr}
  .fp-lt{display:flex;flex-direction:column;min-width:0}
  .fp-lead h2{margin-bottom:10px;font-size:clamp(22px,calc(7px + 1.3vw),40px);font-weight:700;line-height:1.14;letter-spacing:-.3px;color:var(--head);overflow-wrap:break-word;text-wrap:balance}
  .fp-dek{font-family:var(--sf);font-size:clamp(14px,calc(9px + .45vw),18px);line-height:1.5;color:var(--body)}
  .fp-sub{margin-top:10px;font-family:var(--ss);font-size:13px;line-height:1.6;color:var(--body)}
  .fp-sub strong{color:var(--ink)}
  .fp-lt>.cov.mini{max-width:420px}
  /* Coluna da foto: a foto não impõe altura ao pacote. Parte de um recorte
     panorâmico (2,4:1) e cresce até a altura da coluna de texto; se o texto for o
     mais curto, a chamada relacionada desce para o pé dele. Assim as duas colunas
     terminam juntas. Sem script, o trecho do corpo fica sob a foto até 1800 px e,
     acima disso, na coluna do texto; com script (page.js), a manchete escolhe onde
     ficam o trecho (ex-l/ex-r) e a chamada relacionada para a foto ficar perto de 3:2. */
  .fp-lp{display:flex;flex-direction:column;min-width:0;container-type:inline-size}
  .fp-li{flex:1 1 0;width:100%;min-height:41.6cqw}
  .fp-lead:not(.noimg) .fp-sub-t{display:none}
  .fp-rel{z-index:2;margin-top:auto;padding-top:12px;border-top:1px solid var(--rl)}
  .fp-lt>:has(+.fp-rel){margin-bottom:16px}
  .fp-lp>.fp-rel{margin-top:14px}
  .fp-lead.ex-l:not(.noimg) .fp-sub-t,.fp-lead.ex-r .fp-sub-p{display:block}
  .fp-lead.ex-r:not(.noimg) .fp-sub-t,.fp-lead.ex-l .fp-sub-p{display:none}
  /* Foto que não carrega: o pacote vira uma coluna só, com o trecho sob o título */
  .fp-lead:has(.fp-li.img-fail) .fp-lt>.fp-sub-t{display:block}
  /* Parágrafos seguintes do corpo: sem foto, sempre; com foto, só quando page.js
     os escolhe (x1, x2) para a coluna de texto acompanhar a foto */
  .fp-sub-x{display:none}
  .fp-lead.noimg .fp-sub-x,.fp-lead:has(.fp-li.img-fail) .fp-sub-x,.fp-lead.ex-l.x1 .fp-sub-x1,.fp-lead.ex-l.x2 :is(.fp-sub-x1,.fp-sub-x2){display:block}
  .fp-lead:has(.fp-li.img-fail) .fp-lp>:not(.fp-rel){display:none}
  .fp-rel h3,.fp-r1 h3{text-wrap:balance}
  .fp-rel h3{font-size:clamp(15px,calc(9px + .45vw),19px);font-weight:700;line-height:1.26;color:var(--ink)}

  /* "Mais para ler": numerais azuis como nos Destaques, linha fina inteira */
  .fp-more{border-top:1px solid var(--fr)}
  .fp-ml{list-style:none;counter-reset:fpm;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
  .fp-mi{counter-increment:fpm;display:flex;align-items:flex-start;gap:14px;padding:14px 20px 14px 0;border-bottom:1px solid var(--rl)}
  .fp-mi::before{content:counter(fpm);flex-shrink:0;min-width:18px;margin-top:17px;font-family:var(--sf);font-size:22px;font-weight:900;line-height:1;color:var(--link)}
  .fp-mi:nth-child(even){padding:14px 0 14px 20px}
  .fp-mi:nth-child(even)::after{content:"";position:absolute;left:0;top:14px;bottom:14px;width:1px;background:var(--rl)}
  .fp-mi:last-child:nth-child(odd){grid-column:1/-1;padding-right:0}
  .fp-mi:last-child,.fp-mi:nth-last-child(2):nth-child(odd){border-bottom:none}
  .fp-mt{flex:1;min-width:0}
  .fp-mi h3{font-size:clamp(15px,calc(9px + .45vw),19px);font-weight:700;line-height:1.26;color:var(--ink)}
  .fp-mdk{margin-top:5px;font-family:var(--ss);font-size:12.5px;line-height:1.5;color:var(--muted)}
  .fp-th{flex-shrink:0;width:clamp(72px,5.4vw,128px);aspect-ratio:1}

  /* Em 1 minuto (em colunas: o mesmo espaço entre todos os itens) e racional */
  .fp-brief{margin-top:20px;border-top:1px solid var(--fr)}
  .fp-brief ul{list-style:none;columns:2;column-gap:28px;padding:8px 0 0}
  .fp-brief li{position:relative;break-inside:avoid;margin-bottom:9px;padding-left:16px;font-family:var(--ss);font-size:13px;line-height:1.5;color:var(--body)}
  .fp-brief li::before{content:"";position:absolute;left:0;top:.5em;width:6px;height:6px;border-radius:1px;background:var(--qc)}
  .fp-brief strong{color:var(--ink)}
  .fp-rat{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:2px 18px;margin-top:11px;padding:10px 0 20px;border-top:1px solid var(--rl);font-family:var(--ss);font-size:12px;line-height:1.5;color:var(--muted)}
  .fp-rat-s{color:var(--ink);font-weight:600;text-wrap:balance}
  .fp-rat-l{white-space:nowrap}
  .fp-rat a{color:var(--link);font-weight:700}
  .fp-rat a:hover{text-decoration:underline}

  /* Trilho: chamadas com foto (a primeira em 16:9, com altura limitada) e o Radar */
  .fp-ri{aspect-ratio:3/2;margin-bottom:10px}
  .fp-r1 .fp-ri{width:100%;aspect-ratio:16/9;max-height:15.7vw}
  .fp-r1{padding-bottom:16px;border-bottom:1px solid var(--rl)}
  .fp-r1 h3{font-size:clamp(18px,calc(8px + .8vw),27px);font-weight:700;line-height:1.2;color:var(--ink)}
  .fp-rdk{margin-top:6px;font-family:var(--sf);font-size:clamp(13.5px,calc(9px + .3vw),16px);line-height:1.5;color:var(--body)}
  .fp-r2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));row-gap:16px;padding:16px 0;border-bottom:1px solid var(--rl)}
  .fp-r2i{min-width:0;padding-right:14px}
  .fp-r2i:nth-child(even){padding:0 0 0 14px}
  .fp-r2i:nth-child(even)::before{content:"";position:absolute;left:0;top:0;bottom:0;width:1px;background:var(--rl)}
  .fp-r2i h3{font-size:clamp(14.5px,calc(9px + .4vw),18px);font-weight:700;line-height:1.26;color:var(--ink)}
  /* Radar: ocupa o resto do trilho e rola por dentro; o rodapé diz quantos itens faltam */
  .fp-op{position:relative;flex:1 1 auto;min-height:300px}
  .fp-op-in{position:absolute;inset:0;display:flex;flex-direction:column;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
  .fp-op.more .fp-op-in{bottom:36px}
  /* Esmaecido no pé só no meio da rolagem (no início a lista termina num item inteiro) */
  .fp-op.mid .fp-op-in{-webkit-mask-image:linear-gradient(#000 calc(100% - 26px),transparent);mask-image:linear-gradient(#000 calc(100% - 26px),transparent)}
  /* Se a lista inteira cabe, as linhas se espaçam por igual até o pé do trilho */
  .fp-op ol{flex:1 0 auto;display:flex;flex-direction:column;list-style:none}
  .fp-op li{flex:1 0 auto;display:flex;align-items:center}
  .fp-op .fp-lbl{position:sticky;top:0;z-index:1;margin-top:16px;border-top:1px solid var(--fr);background:var(--paper)}
  .fp-op .fp-lbl::before{content:"";width:6px;height:6px;flex-shrink:0;border-radius:50%;background:var(--qr);animation:pulse 2s infinite}
  .fp-op li+li{border-top:1px solid var(--rl)}
  .fp-op a{flex:1;display:block;padding:calc(10px + var(--rx,0px)/2) 0 calc(11px + var(--rx,0px)/2)}
  .fp-by{display:block;font-family:var(--sf);font-size:13px;font-variant-caps:all-small-caps;letter-spacing:.9px;line-height:1.3;color:var(--mute2)}
  .fp-by time{font-family:var(--mn);font-size:10px;font-variant-caps:normal;letter-spacing:0;color:var(--link)}
  .fp-tt{display:block;margin-top:3px;font-family:var(--sf);font-size:clamp(15px,calc(9px + .42vw),19px);font-weight:600;line-height:1.3;color:var(--ink);transition:color .2s}
  .fp-op-more{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;gap:10px;height:36px;padding:0;border:none;border-top:1px solid var(--fr);background:var(--paper);font-family:var(--ss);font-size:11px;font-weight:700;letter-spacing:.4px;color:var(--link);cursor:pointer}
  .fp-op-more[hidden]{display:none}
  .fp-op-more:hover span:first-child{text-decoration:underline}
  .fp-op-more:focus-visible{outline-offset:-2px}
  .fp-op-more b{font-family:var(--mn);font-weight:600}
  .fp-op-more i{font-style:normal;font-size:14px}

  /* Matérias por editoria: abas como cabeçalho de seção, busca à direita */
  .fp~.tabs-wrap{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;column-gap:24px;margin:24px var(--gut) 0;border-top:4px double var(--fr)}
  .fp~.tabs-wrap>.tabs-nav{grid-column:1;grid-row:1;min-width:0}
  .fp~.tabs-wrap>.srch{grid-column:2;grid-row:1;padding:8px 0;border-top:none;background:transparent}
  .fp~.tabs-wrap>.srch .srch-input{width:300px;height:32px}
  .fp~.tabs-wrap>.tab-layout{grid-column:1/-1;grid-row:2;border-top:1px solid var(--rl)}
  .fp~.tabs-wrap .tabs-bar{padding-left:0;background:transparent;border:none}
  .fp~.tabs-wrap .tab-btn{margin-bottom:0;padding:13px 12px 10px;border-bottom-width:2px}
  .fp~.tabs-wrap .tab-btn:first-child{padding-left:0}
  .fp~.tabs-wrap .tab-btn:hover,.fp~.tabs-wrap .tab-btn[aria-selected="true"]{background:transparent}
  .fp~.tabs-wrap .tab-btn[aria-selected="true"]{border-bottom-width:4px;padding-bottom:8px}
  .fp~.tabs-wrap .tab-main{border-right:none}
  .fp~.tabs-wrap .pane-hd{padding:16px 0 8px}
  /* O Radar fica só no trilho da capa (um Radar só na tela); os cards usam a largura toda. */
  .fp~.tabs-wrap .tab-side{display:none}
  /* Cards sem caixa, com réguas finas: horizontal entre as linhas e vertical entre
     as colunas; miniatura quadrada à direita do texto. O card que sobra na última
     linha se alarga para fechá-la (título à esquerda, linha fina à direita). */
  .fp~.tabs-wrap .cards{margin:0 -20px;padding:0;clip-path:inset(0 20px)}
