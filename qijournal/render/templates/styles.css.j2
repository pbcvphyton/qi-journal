  .fp~.tabs-wrap .cl>.ci,.fp~.tabs-wrap:not(.searching) .cl:last-child:nth-child(n)>.ci{grid-column:2;grid-row:1/-1;width:clamp(76px,5.6vw,120px);height:auto;aspect-ratio:1;margin:2px 0 0}
