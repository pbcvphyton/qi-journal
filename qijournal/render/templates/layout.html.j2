{#- Esqueleto comum às páginas web (edição e arquivo). Variáveis: brand (BrandView). -#}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}{{ brand.name }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ brand.tagline }}{% endblock %}">
<meta name="theme-color" content="{{ brand.colors.navy }}">
<meta name="generator" content="QI Journal 2.0">
{% block meta %}{% endblock %}
<link rel="icon" type="image/svg+xml" href="{{ brand.favicon_uri }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;0,900;1,400&amp;family=Noto+Sans:wght@400;500;600;700;800&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
<script>
{% include "head.js.j2" %}
</script>
<style>
{% include "styles.css.j2" %}
</style>
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<div id="rdprog" aria-hidden="true"></div>
<div class="paper">
<header class="mast-wrap">
  <canvas id="mast-canvas" aria-hidden="true"></canvas>
  <div class="mast-tools">
    {% block tools %}{% endblock %}
    <button class="tool" type="button" id="dmBtn">
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <span class="lbl">Escuro</span>
    </button>
  </div>
  <div class="mast">
    <h1{% if brand.logo_svg %} class="logo"{% endif %}><a href="{% block home_link %}./{% endblock %}">
      {%- if brand.logo_svg %}{{ brand.logo_svg }}{% else %}{% for part, cls in brand.wordmark %}<span class="{{ cls }}">{{ part }}</span>{% endfor %}{% endif -%}
    </a></h1>
    {% if brand.tagline %}
    <p class="mast-sub">{{ brand.tagline }}</p>
    {% endif %}
    <p class="mast-date">{% block dateline %}{% endblock %}</p>
  </div>
</header>
<main id="conteudo">
{% block content %}{% endblock %}
</main>
{% block footer %}{% endblock %}
</div>
{% block after %}{% endblock %}
<button class="btt" id="btt" type="button" aria-label="Voltar ao topo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5 4.5 13l1.4 1.4 5.1-5.1V20h2V9.3l5.1 5.1 1.4-1.4z"/></svg></button>
<script>
{% include "page.js.j2" %}
</script>
</body>
</html>
