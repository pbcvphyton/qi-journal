{#- Página da edição. Variáveis: v (EditionView), brand, home_href, archive_href. -#}
{% extends "layout.html.j2" %}
{% import "macros.html.j2" as m %}
{% import "termometro.html.j2" as tm %}

{% block title %}{{ brand.name }} — {{ v.date_label }}{% endblock %}
{% block description %}{{ v.description }}{% endblock %}
{% block meta %}
<link rel="canonical" href="{{ v.edition_url }}">
<meta property="og:type" content="article">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content="{{ brand.name }}">
<meta property="og:title" content="{{ brand.name }} — {{ v.date_label }}">
<meta property="og:description" content="{{ v.description }}">
<meta property="og:url" content="{{ v.edition_url }}">
{% if v.og_image %}
<meta property="og:image" content="{{ v.og_image }}">
<meta name="twitter:card" content="summary_large_image">
{% else %}
<meta name="twitter:card" content="summary">
{% endif %}
{% endblock %}

{% block home_link %}{{ home_href }}{% endblock %}
{% block dateline %}{{ v.date_label }}{% if v.time_label %}&nbsp;· <span class="nw">{{ v.time_label }} {{ v.tz_label }}</span>{% endif %}{% endblock %}
{#- Computador: data e hora da edição à esquerda do logo (como o cabeçalho de um
    jornal). A hora é a da geração, verdadeira também nas edições do arquivo. -#}
{% block mast_left %}<p class="ml-d">{{ v.date_label }}</p>{% if v.time_label %}<p class="ml-e">Edição das <span class="nw">{{ v.time_label }} {{ v.tz_label }}</span></p>{% endif %}{% endblock %}

{% block tools %}
    <a class="tool" href="{{ archive_href }}" title="Edições anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span>Edições</span></a>
    {% if v.termometro and v.termometro.analitico_href %}
    <a class="tool tool-an" href="{{ v.termometro.analitico_href }}" title="Analítico Político: todo o histórico do termômetro" aria-label="Analítico Político"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18"/><path d="M6 16v-5M11 16V7M16 16v-8M21 16V4"/></svg><span>Analítico</span></a>
    {% endif %}
    {% if v.sections %}
    <button class="tool" type="button" id="srchBtn" aria-controls="srchInput" title="Buscar (atalho: /)"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Buscar</span></button>
    {% endif %}
{% endblock %}

{% block content %}
{% if v.quotes %}
<section class="tk" aria-label="Cotações e indicadores">
  <div class="tk-rail">
    <ul class="tk-track">
      {% for q in v.quotes %}
      <li class="tk-i"{% if q.note %} title="{{ q.note }}"{% endif %}>{{ q.label }} <b>{{ q.display }}</b>{% if q.change %} <span class="{{ q.css }}">{{ q.change }}</span>{% endif %}</li>
      {% endfor %}
    </ul>
  </div>
  <button class="tk-pause" type="button" aria-label="Pausar rolagem das cotações" hidden>&#10074;&#10074;</button>
</section>
{% endif %}

{% if v.weather %}
<section class="wx" aria-label="Clima">
  {% for w in v.weather %}
  <p>{% if w.now_emoji %}<span role="img" aria-label="{{ w.now_desc }}" title="{{ w.now_desc }}">{{ w.now_emoji }}</span>{% endif %}<strong>{{ w.city }}</strong>{{ w.now_temp }} <span aria-hidden="true">↓</span><span class="sr-only">mínima </span>{{ w.today_min }} <span aria-hidden="true">↑</span><span class="sr-only">máxima </span>{{ w.today_max }}<span class="sep" aria-hidden="true">|</span>Amanhã {% if w.tomorrow_emoji %}<span role="img" aria-label="{{ w.tomorrow_desc }}" title="{{ w.tomorrow_desc }}">{{ w.tomorrow_emoji }}</span> {% endif %}<span aria-hidden="true">↓</span><span class="sr-only">mínima </span>{{ w.tomorrow_min }} <span aria-hidden="true">↑</span><span class="sr-only">máxima </span>{{ w.tomorrow_max }}</p>
  {% endfor %}
</section>
{% endif %}

{#- Primeira página no computador (a partir de 1024 px), no desenho de jornal:
    barra de editorias com régua dupla; coluna principal (editorial, manchete com a
    foto à direita e a chamada relacionada, "Mais para ler" e "Em 1 minuto") e trilho
    à direita (chamadas com foto e o Radar). No celular e no tablet estes blocos
    ficam ocultos e valem os de baixo (op-bar, brief, hero, dst), que no computador
    se ocultam. -#}
{% if v.sections %}
<nav class="sec-nav" aria-label="Editorias">
  <div class="sn-in">
  <ul class="sn-ed">
    {% for sec in v.sections %}
    <li><a href="#editorias" data-tab="{{ sec.id }}" style="--sc:{{ sec.color }}">{{ sec.title }}</a></li>
    {% endfor %}
    <li><a href="#editorias" data-tab="all">Todas</a></li>
  </ul>
  {% if v.compared or v.rationale or v.index_url %}
  <ul class="sn-x">
    {% if v.compared %}<li><a href="#cobertura">Cobertura comparada</a></li>{% endif %}
    {% if v.rationale %}<li><a href="#racional">Racional da edição</a></li>{% endif %}
    {% if v.index_url %}<li><a href="{{ v.index_url }}">Todas as {{ v.index_total|num }} notícias</a></li>{% endif %}
  </ul>
  {% endif %}
  </div>
</nav>
{% endif %}

{% if v.lead %}
{% set L = v.lead %}
<div class="fp">
  <div class="fp-main">
    <section class="fp-box" aria-label="Manchete e principais matérias">
      {% if v.editorial %}
      <div class="fp-ed">
        <p class="fp-ed-k">Editorial do dia</p>
        <p class="fp-ed-t">{{ v.editorial|md_lite }}</p>
      </div>
      {% endif %}
      <article class="fp-lead{% if not L.image %} noimg{% endif %}" style="--sc:{{ L.color }}">
        <div class="fp-lt">
          <p class="cat">{{ L.section_title }}</p>
          <h2{{ m.lang(L) }}><a class="hit" href="#{{ L.anchor }}">{{ L.headline }}</a></h2>
          {% if L.dek %}
          <p class="fp-dek"{{ m.lang(L) }}>{{ L.dek }}</p>
          {% endif %}
          {% if v.lead_excerpt %}
          <p class="fp-sub fp-sub-t"{{ m.lang(L) }}>{{ v.lead_excerpt|md_lite }}</p>
          {% endif %}
          {#- Parágrafos seguintes do corpo: aparecem sem foto e, nas telas largas,
              quando a coluna de texto precisa crescer para a foto ficar perto de 3:2 -#}
          {% for paragraph in v.lead_more %}
          <p class="fp-sub fp-sub-x fp-sub-x{{ loop.index }}"{{ m.lang(L) }}>{{ paragraph|md_lite }}</p>
          {% endfor %}
          {{ m.meta(L) }}
          {% if L.coverage %}
          {{ m.badge(L.coverage) }}
          {% endif %}
          {% if v.related %}
          {% set s = v.related %}
          <div class="fp-rel" style="--sc:{{ s.color }}">
            <h3{{ m.lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
            {{ m.meta(s) }}
          </div>
          {% endif %}
        </div>
        {% if L.image %}
        <div class="fp-lp">
          {{ m.figure(L, "fp-li") }}
          {% if v.lead_excerpt %}
          <p class="fp-sub fp-sub-p"{{ m.lang(L) }}>{{ v.lead_excerpt|md_lite }}</p>
          {% endif %}
        </div>
        {% endif %}
      </article>
      {% if v.more %}
      <div class="fp-more">
        <h2 class="fp-lbl">Mais para ler</h2>
        <ol class="fp-ml">
          {% for s in v.more %}
          <li class="fp-mi" style="--sc:{{ s.color }}">
            <div class="fp-mt">
              <p class="cat">{{ s.section_title }}</p>
              <h3{{ m.lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
              {% if s.dek %}
              <p class="fp-mdk"{{ m.lang(s) }}>{{ s.dek }}</p>
              {% endif %}
            </div>
            {% if s.image %}
            {{ m.figure(s, "fp-th") }}
            {% endif %}
          </li>
          {% endfor %}
        </ol>
      </div>
      {% endif %}
    </section>
    {% if v.briefing %}
    <section class="fp-brief" aria-labelledby="fpb-h">
      <h2 class="fp-lbl" id="fpb-h">Em 1 minuto</h2>
      <ul>
        {% for item in v.briefing %}
        <li>{{ item|md_lite }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% if v.rationale %}
    <p class="fp-rat"><span class="fp-rat-s">{{ v.rationale.strip }}</span> <span class="fp-rat-l"><a href="#racional">Como foi compilada</a>{% if v.index_url %} · <a href="{{ v.index_url }}">Todas as {{ v.index_total|num }} notícias</a>{% endif %}</span></p>
    {% endif %}
  </div>
  {% if v.secondary or v.radar %}
  <aside class="fp-rail" aria-label="Outras chamadas e Radar de notícias">
    {% if v.secondary %}
    {% set s = v.secondary[0] %}
    <article class="fp-r1" style="--sc:{{ s.color }}">
      {% if s.image %}
      {{ m.figure(s, "fp-ri") }}
      {% endif %}
      <p class="cat">{{ s.section_title }}</p>
      <h3{{ m.lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
      {% if s.dek %}
      <p class="fp-rdk"{{ m.lang(s) }}>{{ s.dek }}</p>
      {% endif %}
      {{ m.meta(s) }}
      {% if s.coverage %}
      {{ m.badge(s.coverage) }}
      {% endif %}
    </article>
    {% if v.secondary|length > 1 %}
    <div class="fp-r2">
      {% for s in v.secondary[1:] %}
      <article class="fp-r2i" style="--sc:{{ s.color }}">
        {% if s.image %}
        {{ m.figure(s, "fp-ri") }}
        {% endif %}
        <p class="cat">{{ s.section_title }}</p>
        <h3{{ m.lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
        {{ m.meta(s) }}
        {% if s.coverage %}
        {{ m.badge(s.coverage) }}
        {% endif %}
      </article>
      {% endfor %}
    </div>
    {% endif %}
    {% endif %}
    {% if v.radar %}
    <section class="fp-op" aria-labelledby="fpr-h">
      <div class="fp-op-in">
        <h2 class="fp-lbl" id="fpr-h">Radar de notícias <span class="fp-n">{{ v.radar|length }}</span></h2>
        <ol>
          {% for r in v.radar %}
          <li><a href="{{ r.href }}"{% if r.external %} target="_blank" rel="noopener noreferrer"{% endif %}><span class="fp-by">{% if r.time %}<time>{{ r.time }}</time> · {% endif %}{{ r.source }}</span><span class="fp-tt"{% if r.lang %} lang="{{ r.lang }}"{% endif %}>{{ r.title }}</span>{% if r.external %}<span class="sr-only"> (abre a fonte em nova aba)</span>{% endif %}</a></li>
          {% endfor %}
        </ol>
      </div>
      <button class="fp-op-more" type="button" hidden></button>
    </section>
    {% endif %}
  </aside>
  {% endif %}
</div>
{% endif %}

{% if v.editorial %}
<section class="op-bar" aria-label="Editorial do dia">
  <p>{{ v.editorial|md_lite }}</p>
</section>
{% endif %}

{% if v.briefing %}
<section class="brief" aria-labelledby="brief-h">
  <h2 class="kicker" id="brief-h">Em 1 minuto</h2>
  <ul>
    {% for item in v.briefing %}
    <li>{{ item|md_lite }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if v.rationale %}
<p class="rat-strip"><span>{{ v.rationale.strip }}</span> <a href="#racional">Como foi compilada</a>{% if v.index_url %} · <a href="{{ v.index_url }}">Todas as {{ v.index_total|num }} notícias</a>{% endif %}</p>
{% endif %}

{% if v.lead %}
{% set s = v.lead %}
<section class="hero{% if not v.secondary %} solo{% endif %}" aria-label="Manchete">
  <article class="hero-l" style="--sc:{{ s.color }}">
    <p class="cat">{{ s.section_title }}</p>
    <h2{{ m.lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h2>
    {% if s.dek %}
    <p class="dek"{{ m.lang(s) }}>{{ s.dek }}</p>
    {% endif %}
    {% if s.image %}
    {{ m.figure(s, "hi") }}
    {% endif %}
    {% if v.lead_excerpt %}
    <p class="sub"{{ m.lang(s) }}>{{ v.lead_excerpt|md_lite }}</p>
    {% endif %}
    {% for paragraph in v.lead_more %}
    <p class="sub more"{{ m.lang(s) }}>{{ paragraph|md_lite }}</p>
    {% endfor %}
    {{ m.meta(s) }}
    {% if s.coverage %}
    {{ m.badge(s.coverage) }}
    {% endif %}
    <p class="rd" aria-hidden="true">Ler matéria completa →</p>
  </article>
  {% if v.secondary %}
  <div class="hero-r">
    {% for s in v.secondary %}
    <article class="ss" style="--sc:{{ s.color }}">
      <p class="cat">{{ s.section_title }}</p>
      <h3{{ m.lang(s) }}><a class="hit" href="#{{ s.anchor }}">{{ s.headline }}</a></h3>
      {% if s.dek %}
      <p{{ m.lang(s) }}>{{ s.dek }}</p>
      {% endif %}
      {{ m.meta(s) }}
      {% if s.coverage %}
      {{ m.badge(s.coverage) }}
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

{% if v.highlights %}
<section class="dst" aria-labelledby="dst-h">
  <h2 class="kicker" id="dst-h">Destaques</h2>
  <ol>
    {% for s in v.highlights %}
    <li><div><a class="hit" href="#{{ s.anchor }}"{{ m.lang(s) }}>{{ s.headline }}</a><span class="dst-cat">{{ s.section_title }}</span></div></li>
    {% endfor %}
  </ol>
</section>
{% endif %}

{% if v.sections %}
<section class="tabs-wrap{% if v.default_all %} all{% endif %}" id="editorias" aria-label="Matérias por seção">
  <div class="srch" role="search">
    <label class="srch-label" for="srchInput">Buscar</label>
    <input class="srch-input" id="srchInput" type="search" placeholder="Pesquisar nas matérias do dia…" autocomplete="off" spellcheck="false" aria-keyshortcuts="/">
    <span class="srch-count" id="srchCount" role="status" aria-live="polite"></span>
  </div>
  <div class="tabs-nav">
  <button class="tabs-arrow prev" type="button" tabindex="-1" aria-hidden="true" hidden>&#8249;</button>
  <div class="tabs-bar" role="tablist" aria-label="Seções">
    {% for sec in v.sections %}
    {% set on = loop.first and not v.default_all %}
    <button class="tab-btn" type="button" role="tab" id="tab-{{ sec.id }}" data-tab="{{ sec.id }}" aria-controls="pane-{{ sec.id }}" aria-selected="{{ 'true' if on else 'false' }}" tabindex="{{ '0' if on else '-1' }}" style="--sc:{{ sec.color }}">{{ sec.title }}<span class="n">{{ sec.stories|length }}</span></button>
    {% endfor %}
    <button class="tab-btn" type="button" role="tab" id="tab-all" data-tab="all" aria-controls="panes" aria-selected="{{ 'true' if v.default_all else 'false' }}" tabindex="{{ '0' if v.default_all else '-1' }}" style="--sc:{{ brand.colors.primary }}">Todas<span class="n">{{ v.stories|length }}</span></button>
  </div>
  <button class="tabs-arrow next" type="button" tabindex="-1" aria-hidden="true" hidden>&#8250;</button>
  </div>
  <div class="tab-layout">
    <div class="tab-main" id="panes">
      {% for sec in v.sections %}
      <div class="tab-pane{% if loop.first or v.default_all %} active{% endif %}" id="pane-{{ sec.id }}" role="tabpanel" aria-labelledby="tab-{{ sec.id }}" style="--sc:{{ sec.color }}">
        <h2 class="pane-hd">{{ sec.title }}</h2>
        <div class="cards">
          {% for s in sec.stories %}
          {{ m.card(s) }}
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      <p class="no-res" id="noRes" hidden>Nenhuma matéria encontrada para esta busca.</p>
    </div>
    {% if v.radar %}
    <aside class="tab-side" aria-labelledby="radar-h">
      <div class="radar">
        <h2 class="radar-hd" id="radar-h">Radar de Notícias</h2>
        <ol class="radar-list">
          {% for r in v.radar %}
          <li><a class="radar-item" href="{{ r.href }}"{% if r.external %} target="_blank" rel="noopener noreferrer"{% endif %}><span class="tm">{{ r.time }}</span><span class="src">{{ r.source }}</span><span class="tt"{% if r.lang %} lang="{{ r.lang }}"{% endif %}>{{ r.title }}</span>{% if r.external %}<span class="sr-only"> (abre a fonte em nova aba)</span>{% endif %}</a></li>
          {% endfor %}
        </ol>
      </div>
    </aside>
    {% endif %}
  </div>
</section>
{% endif %}

{% if v.rationale %}
<section class="rat" id="racional" aria-labelledby="rat-h">
  <h2 class="kicker" id="rat-h">Racional da edição</h2>
  <p class="rat-sum">{{ v.rationale.summary }}</p>
  {% if v.rationale.blocks %}
  <ol class="rat-blocks">
    {% for b in v.rationale.blocks %}
    <li class="{{ 'ok' if b.ok else 'off' }}"><b>{{ b.name }}</b><span>{{ b.articles|num }} notícias{% if b.ok %} · {{ b.stories }} matérias redigidas · {{ b.compared }} outros assuntos comparados{% else %} · bloco sem resposta da IA (notícias na lista completa){% endif %}</span></li>
    {% endfor %}
  </ol>
  {% endif %}
  {% if v.index_url %}
  <p class="rat-all"><a href="{{ v.index_url }}">Ver todas as {{ v.index_total|num }} notícias do dia, por editoria e assunto &rarr;</a></p>
  {% endif %}
  <p class="rat-note">Na análise de cada assunto, a IA define os dois enfoques do debate, interpreta o foco de cada veículo (o que priorizou, o enquadramento e o que deixou de lado em relação aos outros) e diz para que lado cada um seguiu. A barra cresce para o lado com mais veículos. A análise usa só os títulos e trechos publicados.</p>
</section>
{% endif %}

{% if v.compared %}
<section class="cmp" id="cobertura" aria-labelledby="cmp-h">
  <div class="cmp-top">
    <h2 class="kicker" id="cmp-h">Cobertura comparada</h2>
    <p class="cmp-note">Os demais assuntos do dia vistos por dois ou mais veículos: em que sentido cada um conduziu a cobertura. A barra cresce para o lado com mais veículos; análise feita por IA a partir dos títulos e trechos publicados.</p>
  </div>
  <ol class="cmp-list">
    {% for c in v.compared %}
    <li class="cmp-i" style="--sc:{{ c.color }}">
      <p class="cat">{{ c.section_title }}{% if c.time %} <span class="cmp-t">· {{ c.time }}</span>{% endif %}</p>
      <h3>{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener noreferrer">{{ c.topic }}<span class="sr-only"> (abre a fonte em nova aba)</span></a>{% else %}{{ c.topic }}{% endif %}</h3>
      {{ m.coverage(c) }}
    </li>
    {% endfor %}
  </ol>
</section>
{% endif %}

{% if v.termometro %}
{% set t = v.termometro %}
<section class="term" id="termometro" aria-labelledby="term-h">
  <div class="arch-top">
    <h2 class="kicker" id="term-h">Termômetro do dia</h2>
    {% if t.analitico_href %}<a class="arch-home" href="{{ t.analitico_href }}">Analítico Político &rarr;</a>{% endif %}
  </div>
  {% if t.vazio %}
  <p class="term-note">Sem análise nesta edição: {{ t.motivo }}.</p>
  {% else %}
  <p class="term-sum">{{ t.resumo }}{% if t.gauge and t.gauge.ic %} <span>(intervalo de 95%: {{ t.gauge.ic }})</span>{% endif %}</p>
  {% if t.gauge %}{{ tm.gauge(t.gauge) }}{% endif %}
  {% if t.distribuicao %}{{ tm.dist(t.distribuicao) }}{% endif %}
  <p class="term-meta">{{ t.meta|join(" · ") }}</p>
  <details class="term-det">
    <summary>Cada texto analisado ({{ t.analises|length }})</summary>
    <ol class="ta-list">
      {% for a in t.analises %}
      {{ tm.analise(a) }}
      {% endfor %}
    </ol>
  </details>
  {% endif %}
  <p class="term-note">Termômetro de Viés Editorial (v1.1): a IA aponta, em cada texto compilado, sinais de tratamento desigual com a citação literal; o cálculo confere cada citação no texto e dá T de &minus;100 (esquerda) a +100 (direita). Mede o tratamento dado pelo texto, não a veracidade dos fatos; opinião fica à parte.</p>
</section>
{% endif %}

{% endblock %}

{% block footer %}
<footer class="ft">
  <p><strong>{{ brand.name }}</strong> · {{ v.sources_total }} fontes consultadas · {{ v.mode_label }} · {{ v.date_label }}</p>
  <p class="ft-links"><a href="{{ archive_href }}">Edições anteriores</a>{% if v.instagram_url %} · <a href="{{ v.instagram_url }}" rel="noopener">Siga no Instagram</a>{% endif %}{% if v.repo_url %} · <a href="{{ v.repo_url }}" rel="noopener">Código-fonte</a>{% endif %}</p>
  {% if v.source_groups %}
  <details>
    <summary>Status das fontes · {{ v.sources_ok }} de {{ v.sources_total }} feeds ok</summary>
    <ul class="src-list">
      {% for g in v.source_groups %}
      <li class="st-{{ g.status }}"><span class="dot" aria-hidden="true"></span>{{ g.name }}{% if g.feeds > 1 %} <span class="nf">({{ g.feeds }} feeds)</span>{% endif %}{% if g.failed %}: <em>{{ g.errors|join(", ") }}</em>{% endif %}<span class="sr-only"> — {{ g.status }}</span></li>
      {% endfor %}
    </ul>
  </details>
  {% endif %}
</footer>
{% endblock %}

{% block after %}
<div class="modals">
{% for s in v.stories %}
{{ m.modal(s, v.tz_label) }}
{% endfor %}
</div>
{% endblock %}
