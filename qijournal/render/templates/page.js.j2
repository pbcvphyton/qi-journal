{#- Interações da página (sem bibliotecas): tema, efeito do cabeçalho em canvas 2D,
    ticker, abas, busca, modais das matérias, progresso de leitura e voltar ao topo.
    Cada parte verifica se seus elementos existem (a página do arquivo usa só algumas). -#}
(function () {
  'use strict';
  var d = document, w = window, root = d.documentElement;
  var THEME_KEY = 'qij-theme';
  var noMedia = { matches: false, addEventListener: function () {} };
  function media(query) { return w.matchMedia ? w.matchMedia(query) : noMedia; }
  var reduceMotion = media('(prefers-reduced-motion: reduce)');
  var prefersDark = media('(prefers-color-scheme: dark)');

  function storageGet(key) {
    try { return w.localStorage.getItem(key); } catch (e) { return null; }
  }
  function storageSet(key, value) {
    try { w.localStorage.setItem(key, value); } catch (e) { /* armazenamento indisponível (modo privado) */ }
  }
  function onMediaChange(query, handler) {
    if (query.addEventListener) query.addEventListener('change', handler);
  }
  function onResize(handler) {
    var timer = 0;
    w.addEventListener('resize', function () {
      clearTimeout(timer);
      timer = setTimeout(handler, 150);
    });
  }
  function smooth() { return reduceMotion.matches ? 'auto' : 'smooth'; }

  /* ── Tema claro/escuro ─────────────────────────────────────────────── */
  var themeListeners = [];
  function setupTheme() {
    var button = d.getElementById('dmBtn');
    var label = button && button.querySelector('.lbl');
    function apply(theme) {
      root.setAttribute('data-theme', theme);
      if (label) label.textContent = theme === 'dark' ? 'Claro' : 'Escuro';
      if (button) button.title = theme === 'dark' ? 'Mudar para o modo claro' : 'Mudar para o modo escuro';
      themeListeners.forEach(function (fn) { fn(theme); });
    }
    apply(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
    if (button) {
      button.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        storageSet(THEME_KEY, next);
        apply(next);
      });
    }
    onMediaChange(prefersDark, function (event) {
      var saved = storageGet(THEME_KEY);
      if (saved !== 'dark' && saved !== 'light') apply(event.matches ? 'dark' : 'light');
    });
  }

  /* ── Cabeçalho: rede de partículas em canvas 2D (bem sutil) ────────── */
  function setupCanvas() {
    var canvas = d.getElementById('mast-canvas');
    var ctx = canvas && canvas.getContext ? canvas.getContext('2d') : null;
    if (!ctx) return;
    var LINK = 110, width = 0, height = 0, points = [], frame = 0, visible = true, colors = {};

    function readColors() {
      // --fx-* valem no próprio canvas: o cabeçalho em bloco de cor os redefine.
      var style = getComputedStyle(canvas);
      colors.dot = style.getPropertyValue('--fx-dot').trim() || '#394A7A';
      colors.line = style.getPropertyValue('--fx-line').trim() || '#FF5A1F';
    }
    function resize() {
      var rect = canvas.getBoundingClientRect();
      var ratio = Math.min(w.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      var count = Math.round(Math.min(90, Math.max(24, (width * height) / 2600)));
      points = [];
      for (var i = 0; i < count; i++) {
        points.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.25
        });
      }
    }
    function draw() {
      ctx.clearRect(0, 0, width, height);
      ctx.lineWidth = 1;
      ctx.strokeStyle = colors.line;
      for (var i = 0; i < points.length; i++) {
        for (var j = i + 1; j < points.length; j++) {
          var dx = points[i].x - points[j].x, dy = points[i].y - points[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < LINK) {
            ctx.globalAlpha = 1 - dist / LINK;
            ctx.beginPath();
            ctx.moveTo(points[i].x, points[i].y);
            ctx.lineTo(points[j].x, points[j].y);
            ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 1;
      ctx.fillStyle = colors.dot;
      points.forEach(function (p) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
        ctx.fill();
      });
    }
    function step() {
      frame = 0;
      points.forEach(function (p) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
      });
      draw();
      schedule();
    }
    function schedule() {
      if (!frame && visible && !d.hidden && !reduceMotion.matches) frame = w.requestAnimationFrame(step);
    }
    function stop() {
      if (frame) w.cancelAnimationFrame(frame);
      frame = 0;
    }
    readColors();
    resize();
    draw();
    schedule();
    onResize(function () { resize(); draw(); });
    themeListeners.push(function () { readColors(); draw(); });
    onMediaChange(reduceMotion, function () { stop(); schedule(); });
    d.addEventListener('visibilitychange', function () { stop(); schedule(); });
    if ('IntersectionObserver' in w) {
      new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        stop();
        schedule();
      }).observe(canvas);
    }
  }

  /* ── Ticker: rolagem contínua só quando não cabe numa linha ─────────── */
  function setupTicker() {
    var tk = d.querySelector('.tk');
    if (!tk) return;
    var rail = tk.querySelector('.tk-rail'), track = tk.querySelector('.tk-track'), pause = tk.querySelector('.tk-pause');
    var clone = null;
    function layout() {
      if (clone) { clone.remove(); clone = null; }
      tk.classList.remove('run');
      if (pause) pause.hidden = true;
      if (reduceMotion.matches) return;
      tk.classList.add('run');
      if (track.scrollWidth <= tk.clientWidth) {
        tk.classList.remove('run');
        return;
      }
      clone = track.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      rail.appendChild(clone);
      tk.style.setProperty('--tk-dur', Math.max(20, Math.round(track.scrollWidth / 45)) + 's');
      if (pause) pause.hidden = false;
    }
    if (pause) {
      pause.addEventListener('click', function () {
        var paused = tk.classList.toggle('paused');
        pause.setAttribute('aria-label', paused ? 'Retomar rolagem das cotações' : 'Pausar rolagem das cotações');
        pause.textContent = paused ? '▶' : '❚❚';
      });
    }
    layout();
    onResize(layout);
    onMediaChange(reduceMotion, layout);
  }

  /* ── Abas por seção ────────────────────────────────────────────────── */
  function setupTabs() {
    var wrap = d.querySelector('.tabs-wrap');
    if (!wrap) return null;
    var tabs = Array.prototype.slice.call(wrap.querySelectorAll('[role="tab"]'));
    var panes = Array.prototype.slice.call(wrap.querySelectorAll('.tab-pane'));
    var bar = wrap.querySelector('.tabs-bar');
    var api = { wrap: wrap, onSelect: null };

    function reveal(tab) {
      var left = tab.offsetLeft, right = left + tab.offsetWidth;
      if (left < bar.scrollLeft) bar.scrollLeft = left - 16;
      else if (right > bar.scrollLeft + bar.clientWidth) bar.scrollLeft = right - bar.clientWidth + 16;
    }
    function select(tab, focus) {
      var key = tab.getAttribute('data-tab');
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      wrap.classList.toggle('all', key === 'all');
      panes.forEach(function (p) { p.classList.toggle('active', key === 'all' || p.id === 'pane-' + key); });
      if (focus) tab.focus();
      reveal(tab);
    }
    setupTabArrows(bar);
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        if (api.onSelect) api.onSelect();
        select(tab, false);
      });
    });
    bar.addEventListener('keydown', function (event) {
      var index = tabs.indexOf(d.activeElement);
      if (index < 0) return;
      var next = null;
      if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
      else if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
      else if (event.key === 'Home') next = tabs[0];
      else if (event.key === 'End') next = tabs[tabs.length - 1];
      if (!next) return;
      event.preventDefault();
      if (api.onSelect) api.onSelect();
      select(next, true);
    });
    return api;
  }

  /* Setas de rolagem quando as abas não cabem numa linha (atalho para o mouse). */
  function setupTabArrows(bar) {
    var nav = bar.parentNode;
    var prev = nav.querySelector('.tabs-arrow.prev'), next = nav.querySelector('.tabs-arrow.next');
    if (!prev || !next) return;
    function update() {
      prev.hidden = bar.scrollLeft <= 2;
      next.hidden = bar.scrollLeft + bar.clientWidth >= bar.scrollWidth - 2;
    }
    function scrollBy(direction) {
      bar.scrollBy({ left: direction * bar.clientWidth * 0.6, behavior: smooth() });
    }
    prev.addEventListener('click', function () { scrollBy(-1); });
    next.addEventListener('click', function () { scrollBy(1); });
    bar.addEventListener('scroll', update, { passive: true });
    onResize(update);
    update();
  }

  /* Barra de editorias do computador: cada link leva às abas e abre a da editoria. */
  function setupSectionNav(tabsApi) {
    if (!tabsApi) return;
    Array.prototype.forEach.call(d.querySelectorAll('.sec-nav a[data-tab]'), function (link) {
      link.addEventListener('click', function () {
        var tab = tabsApi.wrap.querySelector('[role="tab"][data-tab="' + link.getAttribute('data-tab') + '"]');
        if (tab) tab.click();
      });
    });
  }

  /* Manchete do computador: escolhe onde ficam o trecho do corpo (sob o título ou
     sob a foto) e a chamada relacionada (sob o texto ou sob a foto), a largura da
     coluna de texto (40%, 45% ou metade), se o título ocupa a largura do pacote
     (abaixo de 1280 px) e, nas telas largas, quantos parágrafos seguintes do corpo
     entram na coluna de texto. Vale a forma em que a foto fica mais perto de 3:2,
     sem vão no pé das colunas e bem maior que a foto da 1ª chamada do trilho; em
     caso de empate, a mais simples. */
  function setupLeadFit() {
    var lead = d.querySelector('.fp-lead:not(.noimg)');
    var lt = lead && lead.querySelector('.fp-lt'), lp = lead && lead.querySelector('.fp-lp');
    var photo = lp && lp.querySelector('.fp-li');
    if (!photo) return;
    var rel = lt.querySelector('.fp-rel'), title = lt.querySelector('h2');
    var extras = lt.querySelectorAll('.fp-sub-x').length;
    var rail = d.querySelector('.fp-r1 .fp-ri');
    var desk = w.matchMedia('(min-width:1024px)');
    var narrow = w.matchMedia('(max-width:1279.98px)'), wide = w.matchMedia('(min-width:1600px)');
    var CLASSES = ['ex-l', 'ex-r', 'wm', 'wt', 'ta', 'x1', 'x2'];
    function options() {
      // {left: trecho na coluna do texto, right: relacionada sob a foto,
      //  split: 0 (40%), 1 (45%), 2 (metade), top: título em toda a largura, more: parágrafos}
      var list = [];
      [false, true].forEach(function (top) {
        if (top && !narrow.matches) return;
        [0, 1, 2].forEach(function (split) {
          [false, true].forEach(function (right) {
            var most = wide.matches ? extras : 0;
            for (var more = 0; more <= most; more++) list.push({ left: true, right: right, split: split, top: top, more: more });
            list.push({ left: false, right: right, split: split, top: top, more: 0 });
          });
        });
      });
      return list;
    }
    function bottomOf(col) {
      var bottom = 0;
      Array.prototype.forEach.call(col.children, function (child) {
        var r = child.getBoundingClientRect();
        if (r.height) bottom = Math.max(bottom, r.bottom);
      });
      return bottom;
    }
    function reset() {
      CLASSES.forEach(function (c) { lead.classList.remove(c); });
      if (rel && rel.parentNode !== lt) lt.appendChild(rel);
    }
    function apply(o) {
      reset();
      lead.classList.add(o.left ? 'ex-l' : 'ex-r');
      if (o.split) lead.classList.add(o.split === 1 ? 'wm' : 'wt');
      if (o.top) lead.classList.add('ta');
      if (o.more) lead.classList.add('x' + o.more);
      if (rel && o.right) lp.appendChild(rel);
    }
    function score(o) {
      var r = photo.getBoundingClientRect();
      if (!r.width || !r.height) return Infinity;
      var gap = Math.abs(bottomOf(lt) - bottomOf(lp)), slack = 0;
      var prev = rel && rel.parentNode === lt ? rel.previousElementSibling : null;
      if (prev) slack = Math.max(0, rel.getBoundingClientRect().top - prev.getBoundingClientRect().bottom - 16);
      var value = Math.abs(Math.log(r.width / r.height / 1.5)) + (gap + slack) / 60;
      // A foto da manchete deve ser bem maior que a da 1ª chamada do trilho
      var other = rail ? rail.getBoundingClientRect() : null;
      if (other && other.width) value += Math.max(0, Math.log(1.5 * other.width * other.height / (r.width * r.height)));
      // Título com mais de 4 linhas (coluna estreita demais) também pesa
      var size = title.getBoundingClientRect().height / (parseFloat(getComputedStyle(title).lineHeight) || 1);
      value += Math.max(0, Math.round(size) - 4) * 0.04;
      return value + o.split * 0.03 + (o.top ? 0.02 : 0) + o.more * 0.05;
    }
    function fit() {
      reset();
      if (!desk.matches || photo.classList.contains('img-fail') || !lp.offsetWidth) return;
      var best = null, bestScore = Infinity;
      options().forEach(function (o) {
        apply(o);
        var value = score(o);
        if (value < bestScore - 0.001) {
          bestScore = value;
          best = o;
        }
      });
      if (best) apply(best);
      else reset();
    }
    var img = photo.querySelector('img');
    if (img) img.addEventListener('error', function () { w.setTimeout(fit, 0); });
    onResize(fit);
    onMediaChange(desk, fit);
    if (d.fonts && d.fonts.ready) d.fonts.ready.then(fit);
    fit();
  }

  /* Radar do trilho (computador): a lista rola por dentro e o rodapé diz quantos
     itens ainda estão abaixo; o clique leva o primeiro deles ao topo da lista (no
     fim, volta ao início). Sem rolagem, a lista termina no pé de um item: a sobra
     (menos que um item) se reparte entre os itens visíveis, sem item cortado. */
  function setupRadarMore() {
    var box = d.querySelector('.fp-op');
    var list = box && box.querySelector('.fp-op-in'), more = box && box.querySelector('.fp-op-more');
    var ol = list && list.querySelector('ol'), head = list && list.querySelector('.fp-lbl');
    if (!list || !more || !ol) return;
    var items = Array.prototype.slice.call(ol.children);
    var below = 0, ticking = false;
    function bottomEdge() { return list.getBoundingClientRect().top + list.clientTop + list.clientHeight; }
    function hidden() {
      var edge = bottomEdge() + 1;
      return items.filter(function (li) { return li.getBoundingClientRect().bottom > edge; });
    }
    function label(text, count, arrow) {
      more.textContent = '';
      var span = d.createElement('span');
      span.appendChild(d.createTextNode(text[0]));
      if (count) {
        var b = d.createElement('b');
        b.textContent = count;
        span.appendChild(b);
      }
      span.appendChild(d.createTextNode(text[1]));
      var icon = d.createElement('i');
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = arrow;
      more.appendChild(span);
      more.appendChild(icon);
    }
    function align() {
      var edge = bottomEdge() - list.scrollTop, fit = 0, last = 0;
      items.some(function (li) {
        var bottom = li.getBoundingClientRect().bottom;
        if (bottom > edge + 0.5) return true;
        fit += 1;
        last = bottom;
        return false;
      });
      if (fit && fit < items.length) ol.style.setProperty('--rx', Math.floor((edge - last) / fit * 100) / 100 + 'px');
    }
    function status() {
      ticking = false;
      if (more.hidden) return;
      below = hidden().length;
      if (below) label(['Mais ', below === 1 ? ' notícia no Radar' : ' notícias no Radar'], String(below), '↓');
      else label(['Voltar ao início do Radar', ''], '', '↑');
      box.classList.toggle('mid', below > 0 && list.scrollTop > 2);
    }
    function layout() {
      box.classList.remove('more');
      box.classList.remove('mid');
      ol.style.removeProperty('--rx');
      more.hidden = !list.clientHeight || list.scrollHeight <= list.clientHeight + 1;
      if (more.hidden) return;
      box.classList.add('more');
      align();
      status();
    }
    function schedule() {
      if (!ticking) {
        ticking = true;
        w.requestAnimationFrame(status);
      }
    }
    more.addEventListener('click', function () {
      var next = below && hidden()[0];
      if (next) {
        var top = next.getBoundingClientRect().top - list.getBoundingClientRect().top - list.clientTop;
        list.scrollTo({ top: list.scrollTop + top - (head ? head.offsetHeight : 0), behavior: smooth() });
      } else list.scrollTo({ top: 0, behavior: smooth() });
    });
    list.addEventListener('scroll', schedule, { passive: true });
    if (w.ResizeObserver) new w.ResizeObserver(layout).observe(box);
    else onResize(layout);
    if (d.fonts && d.fonts.ready) d.fonts.ready.then(layout);
    layout();
  }

  /* ── Busca em tempo real (sem acento e sem diferenciar maiúsculas) ─── */
  var modalIsOpen = function () { return false; };
  function setupSearch(tabsApi) {
    var input = d.getElementById('srchInput');
    if (!input || !tabsApi) return;
    var wrap = tabsApi.wrap;
    var count = d.getElementById('srchCount'), none = d.getElementById('noRes');
    var panes = Array.prototype.slice.call(wrap.querySelectorAll('.tab-pane'));
    function norm(value) {
      return value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }
    var cards = Array.prototype.slice.call(wrap.querySelectorAll('.cl'));
    cards.forEach(function (card) { card.searchText = norm(card.textContent.replace(/\s+/g, ' ')); });

    /* Computador: durante a busca os cards que sobram na última linha de cada seção
       se alargam para fechá-la (sem a busca, o CSS faz isso pela posição do card). */
    var SPANS = ['sp-2', 'sp-3', 'sp-all', 'wide'];
    function fillRows() {
      cards.forEach(function (card) { SPANS.forEach(function (c) { card.classList.remove(c); }); });
      if (!wrap.classList.contains('searching')) return;
      panes.forEach(function (pane) {
        var grid = pane.querySelector('.cards');
        if (!grid || !grid.offsetWidth) return;
        var cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
        var shown = Array.prototype.filter.call(grid.children, function (c) { return !c.classList.contains('is-hidden'); });
        var rest = shown.length % cols;
        if (cols < 2 || !rest) return;
        var last = shown[shown.length - 1];
        if (rest === 1) last.classList.add('sp-all');
        else if (rest === 2 && cols === 4) {
          last.classList.add('sp-2');
          shown[shown.length - 2].classList.add('sp-2', 'wide');
        } else last.classList.add('sp-' + (cols - rest + 1));
        last.classList.add('wide');
      });
    }
    onResize(fillRows);

    function run() {
      var terms = norm(input.value).split(/\s+/).filter(Boolean);
      var total = 0;
      wrap.classList.toggle('searching', terms.length > 0);
      panes.forEach(function (pane) {
        var shown = 0;
        Array.prototype.forEach.call(pane.querySelectorAll('.cl'), function (card) {
          var match = terms.every(function (t) { return card.searchText.indexOf(t) !== -1; });
          card.classList.toggle('is-hidden', !match);
          if (match) shown++;
        });
        pane.classList.toggle('empty', shown === 0);
        total += shown;
      });
      if (count) count.textContent = terms.length ? (total === 1 ? '1 matéria' : total + ' matérias') : '';
      if (none) none.hidden = !terms.length || total > 0;
      fillRows();
    }
    function clear() {
      if (!input.value) return;
      input.value = '';
      run();
    }
    function focusSearch() {
      input.scrollIntoView({ block: 'center', behavior: smooth() });
      input.focus({ preventScroll: true });
    }
    tabsApi.onSelect = clear;
    input.addEventListener('input', run);
    input.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && input.value) {
        event.preventDefault();
        clear();
      }
    });
    var button = d.getElementById('srchBtn');
    if (button) button.addEventListener('click', focusSearch);
    d.addEventListener('keydown', function (event) {
      var target = event.target;
      var typing = target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
      if (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey && !event.altKey && !modalIsOpen()) {
        event.preventDefault();
        focusSearch();
      }
    });
    if (input.value) run();
  }

  /* ── Modais das matérias (#s-<id>) ─────────────────────────────────── */
  function setupModals() {
    var modals = d.querySelectorAll('.mo');
    if (!modals.length) return;
    var paper = d.querySelector('.paper');
    var FOCUSABLE = 'a[href],button:not([disabled]),input:not([disabled]),[tabindex]:not([tabindex="-1"])';
    var current = null, lastFocus = null, trigger = null, pushed = false;

    function find(hash) {
      if (!hash || hash.indexOf('#s-') !== 0) return null;
      var id;
      try { id = decodeURIComponent(hash.slice(1)); } catch (e) { return null; }
      var el = d.getElementById(id);
      return el && el.classList.contains('mo') ? el : null;
    }
    function open(modal) {
      if (current === modal) return;
      if (current) current.classList.remove('on');
      else lastFocus = trigger || d.activeElement;
      trigger = null;
      current = modal;
      modal.classList.add('on');
      modal.scrollTop = 0;
      d.body.classList.add('modal-open');
      if (paper) paper.inert = true;
      var box = modal.querySelector('.ml');
      (box || modal).focus({ preventScroll: true });
    }
    function close() {
      if (!current) return;
      var modal = current;
      current = null;
      modal.classList.remove('on');
      d.body.classList.remove('modal-open');
      if (paper) paper.inert = false;
      if (w.location.hash === '#' + modal.id) {
        // Aberto por um link desta página: voltar no histórico; aberto por URL: só limpar a âncora.
        if (pushed) w.history.back();
        else if (w.history.replaceState) w.history.replaceState(null, '', w.location.pathname + w.location.search);
      }
      pushed = false;
      if (lastFocus && lastFocus.focus && d.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
      lastFocus = null;
    }
    function sync() {
      var modal = find(w.location.hash);
      if (modal) open(modal);
      else close();
    }
    modalIsOpen = function () { return current !== null; };

    d.addEventListener('click', function (event) {
      var link = event.target.closest ? event.target.closest('a[href^="#s-"]') : null;
      if (link && find(link.getAttribute('href'))) {
        pushed = true;
        trigger = link;
      }
    });
    Array.prototype.forEach.call(modals, function (modal) {
      modal.addEventListener('click', function (event) {
        if (event.target === modal || (event.target.closest && event.target.closest('.mc,.mc2'))) close();
      });
    });
    d.addEventListener('keydown', function (event) {
      if (!current) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') {
        var items = Array.prototype.filter.call(current.querySelectorAll(FOCUSABLE), function (el) {
          return el.offsetParent !== null;
        });
        if (!items.length) return;
        var first = items[0], last = items[items.length - 1];
        if (event.shiftKey && (d.activeElement === first || !current.contains(d.activeElement))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && d.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    w.addEventListener('hashchange', sync);
    // Aberto pelo link do e-mail (…/AAAA-MM-DD.html#s-id): uma entrada da edição
    // entra no histórico antes da matéria, para o "voltar" do sistema fechar o
    // modal e cair na edição (em vez de sair do site).
    var initial = find(w.location.hash);
    if (initial && w.history.pushState && w.history.replaceState) {
      w.history.replaceState(null, '', w.location.pathname + w.location.search);
      w.history.pushState(null, '', '#' + initial.id);
      pushed = true;
    }
    sync();
    // O Chromium limpa o foco depois da navegação por âncora: devolve o foco ao
    // diálogo quando a página termina de carregar (leitor de tela anuncia a matéria).
    w.addEventListener('load', function () {
      if (current) (current.querySelector('.ml') || current).focus({ preventScroll: true });
    });
  }

  /* ── Idade relativa ("há 3 h") recalculada na hora da leitura ───────── */
  function setupAges() {
    var now = Date.now();
    Array.prototype.forEach.call(d.querySelectorAll('time[data-age]'), function (el) {
      var then = Date.parse(el.getAttribute('datetime') || '');
      if (isNaN(then)) return;
      var minutes = Math.floor((now - then) / 60000), label;
      if (minutes < 1) label = 'agora';
      else if (minutes < 60) label = 'há ' + minutes + ' min';
      else if (minutes < 24 * 60) label = 'há ' + Math.floor(minutes / 60) + ' h';
      else if (minutes < 48 * 60) label = 'ontem';
      else {
        var day = new Date(then);
        label = ('0' + day.getDate()).slice(-2) + '/' + ('0' + (day.getMonth() + 1)).slice(-2);
      }
      el.textContent = label;
    });
  }

  /* ── Progresso de leitura e voltar ao topo ─────────────────────────── */
  function setupScroll() {
    var progress = d.getElementById('rdprog'), top = d.getElementById('btt');
    var ticking = false;
    function update() {
      ticking = false;
      var y = w.pageYOffset || root.scrollTop;
      var max = root.scrollHeight - w.innerHeight;
      if (progress) progress.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, y / max) : 0) + ')';
      if (top) top.classList.toggle('show', y > 400);
    }
    w.addEventListener('scroll', function () {
      if (!ticking) {
        ticking = true;
        w.requestAnimationFrame(update);
      }
    }, { passive: true });
    if (top) {
      top.addEventListener('click', function () {
        w.scrollTo({ top: 0, behavior: smooth() });
        var skipTarget = d.querySelector('.mast h1');
        if (skipTarget) {
          skipTarget.setAttribute('tabindex', '-1');
          skipTarget.focus({ preventScroll: true });
        }
      });
    }
    update();
  }

  setupTheme();
  setupCanvas();
  setupTicker();
  var tabsApi = setupTabs();
  setupSearch(tabsApi);
  setupSectionNav(tabsApi);
  setupLeadFit();
  setupRadarMore();
  setupAges();
  setupModals();
  setupScroll();
})();
